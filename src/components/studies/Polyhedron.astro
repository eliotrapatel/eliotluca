---
import Study from '../Study.astro';
import { render } from '../../lib/polyhedron';

interface Props {
  delay?: number;
  href?: string;
  quiet?: boolean;
}
const { delay = 0, href = '/about#practice', quiet = false } = Astro.props;

const YAW = -0.62;
const PITCH = 0.42;
const faces = render(YAW, PITCH);
---

<Study
  id="polyhedron"
  title="Rhombicuboctahedron, after Leonardo"
  discipline={quiet ? undefined : '3D industrial modelling'}
  year={quiet ? undefined : 2026}
  href={href}
  viewBox="0 0 320 352"
  delay={delay}
  interactive
  class="polyhedron"
  label="Leonardo's skeletal rhombicuboctahedron, drawn for Luca Pacioli's De divina proportione, 1509. Drag or use the arrow keys to turn it."
>
  <g class="solid" data-yaw={YAW} data-pitch={PITCH}>
    {
      faces.map((f) =>
        f.cls === 'pf-shade' ? (
          <>
            <path class="pf-front" d={f.d} fill-rule="evenodd" />
            <path class="pf-shade" d={f.d} fill-rule="evenodd" />
          </>
        ) : (
          <path class={f.cls} d={f.d} fill-rule="evenodd" />
        ),
      )
    }
  </g>
  <text class="dim hint" x="160" y="336" text-anchor="middle" font-size="13">Drag or use the arrow keys to turn</text>
</Study>

<style>
  :global(.polyhedron .solid path) {
    stroke-linejoin: round;
  }
  :global(.polyhedron .pf-back) {
    fill: url(#hatch-ink);
    stroke: var(--line-3);
    stroke-width: 0.6;
    opacity: 0.75;
  }
  :global(.polyhedron .pf-front) {
    fill: var(--ground);
    stroke: var(--line);
    stroke-width: 1.1;
  }
  :global(.polyhedron .pf-lit) {
    fill: var(--light);
    stroke: var(--line);
    stroke-width: 1.1;
  }
  :global(.polyhedron .pf-shade) {
    fill: url(#hatch-ink);
    stroke: var(--line);
    stroke-width: 1.1;
  }
  :global(.polyhedron .metal) {
    opacity: 0.6;
  }
  @media (prefers-reduced-motion: no-preference) {
    :global(.can-draw body[data-draw] .polyhedron .solid) {
      opacity: 0;
      transform-origin: 160px 160px;
      animation: assemble 1400ms var(--ease-out) forwards;
      animation-delay: calc(var(--d, 0) * 1ms);
    }
  }
  @keyframes assemble {
    from {
      opacity: 0;
      transform: scale(0.94);
      filter: blur(2px);
    }
    to {
      opacity: 1;
      transform: none;
      filter: none;
    }
  }
</style>

<script>
  import { render } from '../../lib/polyhedron';

  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)');

  document.querySelectorAll<SVGSVGElement>('.polyhedron svg[data-interactive]').forEach((svg) => {
    const g = svg.querySelector<SVGGElement>('.solid');
    if (!g) return;
    let yaw = Number(g.dataset.yaw) || 0;
    let pitch = Number(g.dataset.pitch) || 0;
    let vy = 0;
    let vp = 0;
    let dragging = false;
    let lastX = 0;
    let lastY = 0;
    let lastInput = 0;
    let visible = false;
    let raf = 0;
    let prev = 0;

    const draw = () => {
      const faces = render(yaw, pitch);
      const frag: string[] = [];
      for (const f of faces) {
        if (f.cls === 'pf-shade') {
          frag.push(`<path class="pf-front" d="${f.d}" fill-rule="evenodd"/><path class="pf-shade" d="${f.d}" fill-rule="evenodd"/>`);
        } else {
          frag.push(`<path class="${f.cls}" d="${f.d}" fill-rule="evenodd"/>`);
        }
      }
      g.innerHTML = frag.join('');
    };

    const loop = (t: number) => {
      const dt = prev ? Math.min(0.05, (t - prev) / 1000) : 0.016;
      prev = t;
      const idle = !dragging && performance.now() - lastInput > 1800;
      if (!dragging) {
        yaw += vy;
        pitch += vp;
        vy *= 0.94;
        vp *= 0.94;
        if (Math.abs(vy) < 1e-4) vy = 0;
        if (Math.abs(vp) < 1e-4) vp = 0;
      }
      if (idle && !reduce.matches) yaw += 0.16 * dt;
      pitch = Math.max(-1.3, Math.min(1.3, pitch));
      draw();
      const moving = dragging || vy !== 0 || vp !== 0 || (idle && !reduce.matches);
      if (visible && moving) raf = requestAnimationFrame(loop);
      else {
        raf = 0;
        prev = 0;
      }
    };

    const kick = () => {
      if (!raf && visible) raf = requestAnimationFrame(loop);
    };

    svg.addEventListener('pointerdown', (e) => {
      dragging = true;
      lastX = e.clientX;
      lastY = e.clientY;
      lastInput = performance.now();
      svg.setPointerCapture(e.pointerId);
      kick();
    });
    svg.addEventListener('pointermove', (e) => {
      if (!dragging) return;
      const dx = e.clientX - lastX;
      const dy = e.clientY - lastY;
      lastX = e.clientX;
      lastY = e.clientY;
      vy = dx * 0.008;
      vp = -dy * 0.008;
      yaw += vy;
      pitch += vp;
      lastInput = performance.now();
    });
    const end = () => {
      dragging = false;
      lastInput = performance.now();
    };
    svg.addEventListener('pointerup', end);
    svg.addEventListener('pointercancel', end);

    svg.addEventListener('keydown', (e) => {
      const step = 0.14;
      if (e.key === 'ArrowLeft') yaw -= step;
      else if (e.key === 'ArrowRight') yaw += step;
      else if (e.key === 'ArrowUp') pitch += step;
      else if (e.key === 'ArrowDown') pitch -= step;
      else return;
      e.preventDefault();
      lastInput = performance.now();
      draw();
      kick();
    });

    new IntersectionObserver(
      (entries) => {
        visible = entries.some((en) => en.isIntersecting);
        if (visible) {
          // Let the first-visit assembly finish before turning.
          window.setTimeout(kick, document.documentElement.classList.contains('can-draw') ? 1600 : 0);
        }
      },
      { rootMargin: '80px' },
    ).observe(svg);
  });
</script>
