---
import Study from '../Study.astro';

interface Props {
  delay?: number;
  href?: string;
}
const { delay = 0, href = '/instruments/returns' } = Astro.props;

// Illustrative bridge on a base of 100. The steps must sum to the exit value.
const entry = 100;
const steps = [
  { label: ['EBITDA', 'growth'], value: 85 },
  { label: ['Multiple', 'expansion'], value: 30 },
  { label: ['Debt', 'paydown'], value: 45 },
];
const exit = entry + steps.reduce((s, x) => s + x.value, 0); // 260
if (exit !== 260) throw new Error(`Bridge does not close: ${exit}`);
const multiple = exit / entry; // 2.6

const base = 214; // baseline y
const scale = 0.66; // viewBox units per point of value
const slot = 58.4;
const w = 34;
const cx = (i: number) => 43.2 + slot * i;
const yAt = (v: number) => +(base - v * scale).toFixed(2);

type Bar = {
  i: number;
  from: number;
  to: number;
  total: boolean;
  label: string[];
  text: string;
};

let run = entry;
const bars: Bar[] = [
  { i: 0, from: 0, to: entry, total: true, label: ['Entry', 'equity'], text: String(entry) },
  ...steps.map((s, k) => {
    const b = { i: k + 1, from: run, to: run + s.value, total: false, label: s.label, text: `+${s.value}` };
    run += s.value;
    return b;
  }),
  { i: 4, from: 0, to: exit, total: true, label: ['Exit', 'equity'], text: String(exit) },
];

const geo = bars.map((b) => {
  const x = +(cx(b.i) - w / 2).toFixed(2);
  const top = yAt(b.to);
  const bottom = yAt(b.from);
  return { ...b, x, top, bottom, h: +(bottom - top).toFixed(2) };
});

// The dimension line for value created stands just right of the exit bar.
const dimX = geo[4].x + w + 6;

// Connectors run from the top of each bar to the next one, at the running total.
const connectors = geo.slice(0, -1).map((g, k) => ({ x1: g.x + w, x2: geo[k + 1].x, y: g.top }));
---

<Study
  id="bridge"
  title="Equity value bridge"
  discipline="Finance and private equity"
  year={2021}
  href={href}
  viewBox="0 0 320 254"
  delay={delay}
  label="An illustrative equity value bridge on a base of 100: entry equity 100, plus 85 from EBITDA growth, plus 30 from multiple expansion, plus 45 from debt paydown, gives exit equity of 260, a 2.6 times money multiple."
>
  <!-- construction: the entry level carried across to the exit bar -->
  <line class="metal" x1={geo[1].x + w} y1={yAt(entry)} x2={dimX + 4} y2={yAt(entry)} opacity="0.7" />

  <!-- baseline -->
  <line class="ink" x1="10" y1={base} x2="310" y2={base} pathLength="1" style={`--d: ${delay}`} />

  {
    geo.map((g) => (
      <g style={`--d: ${delay + 120 + g.i * 120}`}>
        {!g.total && <rect class="settle" x={g.x} y={g.top} width={w} height={g.h} fill="url(#hatch-ink)" />}
        {g.total && <line class="lead" x1={g.x + 3} y1={g.bottom - 1.5} x2={g.x + 3} y2={g.top + 2.5} />}
        <rect class="ink" x={g.x} y={g.top} width={w} height={g.h} pathLength="1" />
        <text class="dim" font-size="10" x={cx(g.i)} y={g.top - 5} text-anchor="middle">
          {g.text}
        </text>
        <text class="dim" font-size="10" x={cx(g.i)} y={base + 14} text-anchor="middle">
          {g.label[0]}
        </text>
        <text class="dim" font-size="10" x={cx(g.i)} y={base + 26} text-anchor="middle">
          {g.label[1]}
        </text>
      </g>
    ))
  }

  {
    connectors.map((c, k) => (
      <line class="ink-fine" x1={c.x1} y1={c.y} x2={c.x2} y2={c.y} pathLength="1" style={`--d: ${delay + 200 + k * 120}`} />
    ))
  }

  <!-- dimension: value created between the entry and exit levels -->
  <line class="ink-fine" x1={geo[4].x + w + 2} y1={yAt(exit)} x2={dimX + 4} y2={yAt(exit)} />
  <line class="ink-fine" x1={dimX} y1={yAt(entry) - 1} x2={dimX} y2={yAt(exit) + 1} marker-start="url(#arrow)" marker-end="url(#arrow)" pathLength="1" style={`--d: ${delay + 760}`} />
  <text class="dim" font-size="10" text-anchor="middle" transform={`translate(${dimX + 11} ${(yAt(entry) + yAt(exit)) / 2}) rotate(-90)`}>+{exit - entry}</text>

  <text class="note" font-size="12.5" x="12" y="24">illustrative: {multiple.toFixed(1)}× money multiple</text>
</Study>
