---
import Study from '../Study.astro';

interface Props {
  delay?: number;
  href?: string;
}
import { essayHref } from '../../lib/writing';
const { delay = 0, href: hrefProp = '/writing/defi-competes-on-mechanics' } = Astro.props;
const href = await essayHref(hrefProp);

// Plot space: u to the right, v up, in viewBox units from the origin O.
// The curve is u · v = K exactly; every point below is computed from K.
const O = { x: 46, y: 248 };
const K = 10000;
const X = (u: number) => +(O.x + u).toFixed(2);
const Y = (v: number) => +(O.y - v).toFixed(2);

// Point A sits on the curve; the swap adds dx and lands on B, also on the curve.
const uA = 100;
const vA = K / uA; // 100
const dx = 100;
const uB = uA + dx; // 200
const vB = K / uB; // 50, so the pool releases dy = vA - vB = 50
const A = { x: X(uA), y: Y(vA) };
const B = { x: X(uB), y: Y(vB) };
const C = { x: X(uB), y: Y(vA) }; // corner of the swap rectangle

// The hyperbola, sampled evenly in log space (u = r·e^t, v = r·e^-t) so the
// knee gets as many points as the long tails.
const r = Math.sqrt(K);
const t0 = Math.log(K / 224 / r); // top end at v = 224
const t1 = Math.log(256 / r); // right end at u = 256
const N = 96;
const curve = Array.from({ length: N + 1 }, (_, i) => {
  const t = t0 + ((t1 - t0) * i) / N;
  return `${i ? 'L' : 'M'}${X(r * Math.exp(t))} ${Y(r * Math.exp(-t))}`;
}).join('');

// The traded stretch of the curve, A to B, for the heightening underlay.
const traded = Array.from({ length: 33 }, (_, i) => {
  const u = uA + (dx * i) / 32;
  return `${i ? 'L' : 'M'}${X(u)} ${Y(K / u)}`;
}).join('');

// Tangent at A: slope dv/du = -K / uA² = -vA / uA, so the spot price is y / x.
const m = -vA / uA;
const tan = (u: number) => ({ x: X(u), y: Y(vA + m * (u - uA)) });
const T1 = tan(50);
const T2 = tan(116);

// Lettering parallel to the tangent, set just below it.
const angle = (Math.atan2(-m, 1) * 180) / Math.PI; // screen angle of the tangent
const P = tan(66);
const off = 12;
const nx = -Math.sin((angle * Math.PI) / 180) * off;
const ny = Math.cos((angle * Math.PI) / 180) * off;
const priceAt = { x: +(P.x + nx).toFixed(2), y: +(P.y + ny).toFixed(2) };
---

<Study
  id="amm"
  title="Constant-product market maker"
  discipline="Blockchain and crypto"
  year={2017}
  href={href}
  viewBox="0 0 320 272"
  delay={delay}
  label="The curve x times y equals k for a two-asset liquidity pool. A swap adds delta x of one asset and removes delta y of the other, moving the pool from point A to point B on the same curve. The tangent at A gives the spot price, y over x."
>
  <!-- construction: the axis of symmetry u = v and the chord of the trade -->
  <line class="metal" x1={O.x} y1={O.y} x2={X(150)} y2={Y(150)} opacity="0.7" />
  <line class="metal" x1={A.x} y1={A.y} x2={B.x} y2={B.y} />

  <!-- swap rectangle, lightly hatched -->
  <g opacity="0.4">
    <rect class="settle" x={A.x} y={A.y} width={B.x - A.x} height={B.y - A.y} fill="url(#hatch-ink)" style={`--d: ${delay + 500}`} />
  </g>

  <!-- projections to both axes -->
  <path class="metal" d={`M${A.x} ${A.y}V${O.y}M${A.x} ${A.y}H${O.x}M${B.x} ${B.y}V${O.y}M${B.x} ${B.y}H${O.x}`} />

  <!-- axes -->
  <line class="ink" x1={O.x} y1={O.y} x2={X(262)} y2={O.y} marker-end="url(#arrow)" pathLength="1" />
  <line class="ink" x1={O.x} y1={O.y} x2={O.x} y2={Y(236)} marker-end="url(#arrow)" pathLength="1" />

  <!-- heightening along the traded stretch, under the ink -->
  <path class="lead" d={traded} style={`--d: ${delay + 300}`} />

  <!-- the curve x · y = k -->
  <path class="ink-bold" d={curve} pathLength="1" style={`--d: ${delay + 150}`} />

  <!-- the swap: add Δx, then remove Δy -->
  <line class="ink-fine" x1={A.x + 4} y1={A.y} x2={C.x - 1} y2={C.y} marker-end="url(#arrow)" pathLength="1" style={`--d: ${delay + 520}`} />
  <line class="ink-fine" x1={C.x} y1={C.y + 1} x2={B.x} y2={B.y - 3.6} marker-end="url(#arrow)" pathLength="1" style={`--d: ${delay + 640}`} />

  <!-- tangent at A -->
  <line class="ink-fine" x1={T1.x} y1={T1.y} x2={T2.x} y2={T2.y} pathLength="1" style={`--d: ${delay + 700}`} />

  <!-- points A and B -->
  <circle class="lead-fill" cx={A.x} cy={A.y} r="2.6" style={`--d: ${delay + 300}`} />
  <circle class="ink-fine" cx={A.x} cy={A.y} r="2.6" pathLength="1" style={`--d: ${delay + 300}`} />
  <circle class="lead-fill" cx={B.x} cy={B.y} r="2.6" style={`--d: ${delay + 300}`} />
  <circle class="ink-fine" cx={B.x} cy={B.y} r="2.6" pathLength="1" style={`--d: ${delay + 300}`} />

  <!-- lettering -->
  <text class="note" font-size="12.5" x={A.x + 5} y={A.y - 6}>A</text>
  <text class="note" font-size="12.5" x={B.x - 12} y={B.y + 15}>B</text>
  <text class="dim" font-size="10" x={(A.x + C.x) / 2} y={A.y - 6} text-anchor="middle">+Δx</text>
  <text class="dim" font-size="10" x={C.x + 6} y={(C.y + B.y) / 2 + 3.5}>−Δy</text>

  <text class="dim" font-size="10" x={A.x} y={O.y + 14} text-anchor="middle">x</text>
  <text class="dim" font-size="10" x={B.x} y={O.y + 14} text-anchor="middle">x + Δx</text>
  <text class="dim" font-size="10" x={O.x - 6} y={A.y + 3.5} text-anchor="end">y</text>
  <text class="dim" font-size="10" x={O.x - 6} y={B.y + 3.5} text-anchor="end">y − Δy</text>
  <text class="dim" font-size="10" x={O.x - 6} y={O.y + 14} text-anchor="end">0</text>

  <text class="dim" font-size="10" x={X(260)} y={O.y - 7} text-anchor="end">reserve x</text>
  <text class="dim" font-size="10" text-anchor="end" transform={`translate(${O.x - 8} ${Y(222)}) rotate(-90)`}>reserve y</text>

  <text class="dim" font-size="10" text-anchor="middle" transform={`translate(${priceAt.x} ${priceAt.y}) rotate(${angle.toFixed(2)})`}>price = y / x</text>

  <text class="note" font-size="12.5" x={X(66)} y={Y(184)}>x · y = k</text>
</Study>
