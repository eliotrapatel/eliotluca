---
// ORBES, tipped in as a plate in the house's own identity: black stock, wide
// capitals. The ring is computed, not traced: a sculpted band in three-quarter
// view, projected orthographically with its hidden lines removed, set with a
// channel of step-cut baguettes. Same geometry on every build.
interface Props {
  size?: 'feature' | 'compact';
}
const { size = 'feature' } = Astro.props;
const compact = size === 'compact';

const RELEASE = 'https://verify.theorbes.com';
const HOUSE = 'https://theorbes.com';

// ---------------------------------------------------------------- geometry
const { sin, cos, PI, max, min, round } = Math;
const deg = PI / 180;

const RI = 84; // inner radius
const W = 30; // band width along the axis
const HW = W / 2;
// Sculpted: the band thickens towards the crown, under the stones.
const RO = (t: number) => 96 + 10 * max(0, sin(t)) ** 2;
const dRO = (t: number) => (sin(t) > 0 ? 20 * sin(t) * cos(t) : 0);

const YAW = 32 * deg; // turned to show the band's width
const PITCH = 42 * deg; // seen from above, so the crown faces the eye
const S = 2; // drawing units per model unit, so lettering reads near 1:1
const ca = cos(YAW);
const sa = sin(YAW);
const cb = cos(PITCH);
const sb = sin(PITCH);

type P = [number, number];

function rot(x: number, y: number, z: number) {
  const x1 = x * ca + z * sa;
  const z1 = -x * sa + z * ca;
  const y2 = y * cb - z1 * sb;
  const z2 = y * sb + z1 * cb;
  return { x: x1, y: -y2, z: z2 };
}
const proj = (x: number, y: number, z: number): P => {
  const p = rot(x, y, z);
  return [p.x * S, p.y * S];
};
// Point on the outer surface, lifted off it by `lift` (for the stones).
const outer = (t: number, z: number, lift = 0): P => {
  const r = RO(t) + lift;
  return proj(r * cos(t), r * sin(t), z);
};
const inner = (t: number, z: number): P => proj(RI * cos(t), RI * sin(t), z);

// How squarely a surface faces the viewer (z of its rotated unit normal).
function facingOuter(t: number) {
  const r = RO(t);
  const dr = dRO(t);
  const tx = dr * cos(t) - r * sin(t);
  const ty = dr * sin(t) + r * cos(t);
  const l = Math.hypot(tx, ty);
  return rot(ty / l, -tx / l, 0).z;
}
const facingInner = (t: number) => rot(-cos(t), -sin(t), 0).z;

const STEPS = 240; // 1.5 degree chords: under a twentieth of a pixel off the true curve
const ts = Array.from({ length: STEPS + 1 }, (_, i) => (i / STEPS) * 2 * PI);

const f2 = (v: number) => (round(v * 10) / 10).toString();
const pathOf = (pts: P[], close = false) =>
  pts.length < 2 ? '' : 'M' + pts.map((p) => f2(p[0]) + ' ' + f2(p[1])).join('L') + (close ? 'Z' : '');

// Split a sampled curve into the runs where `keep` holds.
function runs(pts: P[], keep: boolean[]) {
  const out: string[] = [];
  let cur: P[] = [];
  pts.forEach((p, i) => {
    if (keep[i]) cur.push(p);
    else {
      if (cur.length > 1) out.push(pathOf(cur));
      cur = [];
    }
  });
  if (cur.length > 1) out.push(pathOf(cur));
  return out.join('');
}
// The same for a straight line: only the ends of each run are needed.
const runsStraight = (pts: P[], keep: boolean[]) =>
  runs(pts, keep)
    .split('M')
    .filter(Boolean)
    .map((r) => {
      const v = r.split('L');
      return 'M' + v[0] + (v.length > 1 ? 'L' + v[v.length - 1] : '');
    })
    .join('');

// The finger hole as seen from the front: everything behind the band shows
// only through it.
const hole: P[] = ts.map((t) => inner(t, HW));
function inHole(p: P) {
  let c = false;
  for (let i = 0, j = hole.length - 1; i < hole.length; j = i++) {
    const [xi, yi] = hole[i];
    const [xj, yj] = hole[j];
    if (yi > p[1] !== yj > p[1] && p[0] < ((xj - xi) * (p[1] - yi)) / (yj - yi) + xi) c = !c;
  }
  return c;
}

// Edges of the band.
const frontOuter = pathOf(ts.map((t) => outer(t, HW)), true);
const frontInner = pathOf(hole, true);
const bevelOuter = pathOf(ts.map((t) => proj((RO(t) - 2.2) * cos(t), (RO(t) - 2.2) * sin(t), HW)), true);
const bevelInner = pathOf(ts.map((t) => proj((RI + 2.2) * cos(t), (RI + 2.2) * sin(t), HW)), true);
const backOuter = runs(
  ts.map((t) => outer(t, -HW)),
  ts.map((t) => facingOuter(t) > 0),
);
const backInnerPts = ts.map((t) => inner(t, -HW));
const backInner = runs(
  backInnerPts,
  ts.map((t, i) => facingInner(t) > 0 && inHole(backInnerPts[i])),
);

// The metal as a solid: the front face and the visible outer surface are
// filled with the plate's black so construction lines pass behind them.
const visIdx = ts.slice(0, STEPS).map((t) => facingOuter(t) > 0);
const startIdx = visIdx.findIndex((v, i) => v && !visIdx[(i - 1 + STEPS) % STEPS]);
const band: number[] = [];
for (let k = 0; k < STEPS; k++) {
  const i = (startIdx + k) % STEPS;
  if (!visIdx[i]) break;
  band.push(i);
}
const solidBand = pathOf(band.map((i) => outer(ts[i], HW)).concat([...band].reverse().map((i) => outer(ts[i], -HW))), true);
const solidFace = frontOuter + frontInner;

// Silhouettes: where the outer surface turns away from the eye.
const outerSil: string[] = [];
for (let i = 0; i < STEPS; i++) {
  const a = facingOuter(ts[i]);
  const b = facingOuter(ts[i + 1]);
  if (a > 0 !== b > 0) {
    const t = ts[i] + ((ts[i + 1] - ts[i]) * a) / (a - b);
    outerSil.push(pathOf([outer(t, HW), outer(t, -HW)]));
  }
}
// The inner surface's silhouette, as far as the hole reveals it.
const innerSil: string[] = [];
for (let i = 0; i < STEPS; i++) {
  const a = facingInner(ts[i]);
  const b = facingInner(ts[i + 1]);
  if (a > 0 !== b > 0) {
    const t = ts[i] + ((ts[i + 1] - ts[i]) * a) / (a - b);
    const seg = Array.from({ length: 61 }, (_, k) => inner(t, HW - (k / 60) * W));
    innerSil.push(runsStraight(seg, seg.map(inHole)));
  }
}

// ---------------------------------------------------------------- stones
// A channel of baguettes across the crown. The run is centred a little forward of the crown and carries on over it,
// so the far stones turn away out of sight as they would on the hand.
const bestT = 102 * deg;
const N_STONES = 13;
const PITCH_A = 8.6 * deg; // angular pitch of the setting
const firstT = bestT - ((N_STONES - 1) / 2) * PITCH_A;
const stoneTs = Array.from({ length: N_STONES }, (_, i) => firstT + i * PITCH_A);

const HZ = HW - 3.6; // half length of a baguette along the axis
const GAP = 0.15; // share of the pitch left as metal between stones

type Stone = { girdle: string; step: string; table: string; corners: string; o: number };

function quad(tc: number, ht: number, hz: number, lift: number) {
  // A rectangle on the curved surface: long sides follow the band.
  const n = 6;
  const pts: P[] = [];
  for (let k = 0; k <= n; k++) pts.push(outer(tc - ht + (2 * ht * k) / n, hz, lift));
  for (let k = 0; k <= n; k++) pts.push(outer(tc + ht - (2 * ht * k) / n, -hz, lift));
  return pts;
}

const stones: Stone[] = stoneTs
  .filter((tc) => facingOuter(tc) > 0.12)
  .map((tc) => {
    const r = RO(tc);
    const ht = (PITCH_A * (1 - GAP)) / 2;
    const hw = r * ht; // half width, absolute
    const stepM = 1.7;
    const tableM = 3.4;
    const g = quad(tc, ht, HZ, 0.4);
    const s = quad(tc, (hw - stepM) / r, HZ - stepM, 1.5);
    const tb = quad(tc, (hw - tableM) / r, HZ - tableM, 2.5);
    const cornersIdx = [0, 6, 7, 13];
    const corners = cornersIdx.map((i) => pathOf([g[i], tb[i]])).join('');
    return {
      girdle: pathOf(g, true),
      step: pathOf(s, true),
      table: pathOf(tb, true),
      corners,
      o: round(min(1, 0.45 + facingOuter(tc)) * 100) / 100,
    };
  });

// Channel walls along the setting.
const chT0 = stoneTs[0] - PITCH_A * 0.62;
const chT1 = stoneTs[N_STONES - 1] + PITCH_A * 0.62;
const chSamples = Array.from({ length: 121 }, (_, i) => chT0 + ((chT1 - chT0) * i) / 120);
const rail = (z: number) =>
  runs(
    chSamples.map((t) => outer(t, z, 0.5)),
    chSamples.map((t) => facingOuter(t) > 0.02),
  );
const rails = rail(HZ + 1.7) + rail(-(HZ + 1.7));
const railEnds = [chT0, chT1]
  .filter((t) => facingOuter(t) > 0.02)
  .map((t) => pathOf([outer(t, HZ + 1.7, 0.5), outer(t, -(HZ + 1.7), 0.5)]))
  .join('');

// ---------------------------------------------------------------- engraving
// Hatching along the band's generators: denser and darker as the surface
// turns away, absent where it catches the light.
// Four tones are enough for the eye; one path per tone keeps the markup light.
const TONES = [0.16, 0.26, 0.38, 0.52];
const hatchOuter: string[] = TONES.map(() => '');
for (let t = 0; t < 2 * PI; t += 2.6 * deg) {
  const f = facingOuter(t);
  if (f <= 0.015 || f > 0.62) continue;
  if (t > chT0 - 1.5 * deg && t < chT1 + 1.5 * deg) continue;
  const k = min(TONES.length - 1, Math.floor((1 - f / 0.62) ** 1.4 * TONES.length));
  hatchOuter[k] += pathOf([outer(t, HW - 0.8), outer(t, -HW + 0.8)]);
}
const hatchInner: string[] = [];
for (let t = 0; t < 2 * PI; t += 3.2 * deg) {
  if (facingInner(t) <= 0.02) continue;
  const seg = Array.from({ length: 49 }, (_, k) => inner(t, HW - (k / 48) * W));
  hatchInner.push(runsStraight(seg, seg.map(inHole)));
}

// ---------------------------------------------------------------- construction
const C0 = proj(0, 0, 0);
const axis = pathOf([proj(0, 0, -118), proj(0, 0, 92)]);
const diaH = pathOf([proj(-128, 0, 0), proj(128, 0, 0)]);
const diaV = pathOf([proj(0, -128, 0), proj(0, 128, 0)]);
const RS = 122; // setting-out arc, on the front face plane
const arcTs = Array.from({ length: 61 }, (_, i) => chT0 + ((chT1 - chT0) * i) / 60);
const setArc = pathOf(arcTs.map((t) => proj(RS * cos(t), RS * sin(t), HW)));
const setTicks = [...stoneTs.map((t) => t - PITCH_A / 2), chT1 - PITCH_A * 0.12]
  .map((t) => pathOf([proj((RO(t) + 4) * cos(t), (RO(t) + 4) * sin(t), HW), proj((RS + 4) * cos(t), (RS + 4) * sin(t), HW)]))
  .join('');
const radials = [stoneTs[0] - PITCH_A / 2, stoneTs[N_STONES - 1] + PITCH_A / 2]
  .map((t) => pathOf([proj(0, 0, HW), proj(RS * cos(t), RS * sin(t), HW)]))
  .join('');

// ---------------------------------------------------------------- notes
// Both notes stand off to the left, outside the band.
const aStone = outer(stoneTs[N_STONES - 3], HZ * 0.55, 2.5);
const aGold = outer(206 * deg, -HW * 0.3);
const notes = [
  { at: aStone, to: [aStone[0] - 40, aStone[1] - 30] as P, text: 'Emerald baguettes', anchor: 'end' },
  { at: aGold, to: [aGold[0] - 34, aGold[1] + 34] as P, text: '18ct gold', anchor: 'end' },
];

// ---------------------------------------------------------------- frame
const noteBox: P[] = notes.flatMap((n) => {
  const w = n.text.length * 7.1 + 14;
  const x = n.anchor === 'start' ? n.to[0] + w : n.to[0] - w;
  return [n.to, [x, n.to[1] - 10], [x, n.to[1] + 8]] as P[];
});
const ringPts: P[] = [
  ...ts.map((t) => outer(t, HW)),
  ...ts.map((t) => outer(t, -HW)),
  proj(0, 0, -118),
  proj(0, 0, 92),
  proj(-128, 0, 0),
  proj(128, 0, 0),
  proj(0, -128, 0),
  proj(0, 128, 0),
];
const all: P[] = [...ringPts, ...(compact ? [] : noteBox)];
const ringX0 = Math.floor(Math.min(...ringPts.map((p) => p[0])) - 14);
let x0 = Math.min(...all.map((p) => p[0]));
let x1 = Math.max(...all.map((p) => p[0]));
let y0 = Math.min(...all.map((p) => p[1]), ...arcTs.map((t) => proj(RS * cos(t), RS * sin(t), HW)[1]));
let y1 = Math.max(...all.map((p) => p[1]));
const PAD = 14;
x0 = Math.floor(x0 - PAD);
y0 = Math.floor(y0 - PAD);
x1 = Math.ceil(x1 + PAD);
y1 = Math.ceil(y1 + PAD);
const viewBox = `${x0} ${y0} ${x1 - x0} ${y1 - y0}`;
// Share of the width the notes add on the left. Where the notes are hidden
// (narrow plates), the figure crops it away so the ring keeps its size.
const crop = round(((ringX0 - x0) / (x1 - x0)) * 10000) / 10000;

const ringLabel =
  'Illustrative line study of a ring in three-quarter view: a sculpted band, thicker at the crown, channel-set with a row of baguette-cut stones drawn with their step-cut facets, over faint construction lines.';
---

<article class:list={['plate', `plate--${size}`]} aria-label="ORBES">
  <div class="inner">
  <header class="head">
    {
      compact ? (
        <a class="mark" href={RELEASE} aria-label="ORBES, see the release">
          ORBES
        </a>
      ) : (
        <p class="mark">ORBES</p>
      )
    }
    <p class="place">Paris, 2026</p>
  </header>

  <figure class="ring" style={`--crop:${max(0, crop)}`}>
    <svg viewBox={viewBox} role="img" aria-label={ringLabel}>
      <title>{ringLabel}</title>
      <g class="construct" aria-hidden="true">
        <path class="dashdot" d={axis} />
        <path class="dashdot" d={diaH} />
        <path class="dashdot" d={diaV} />
        <path d={radials} />
        <path d={setArc} />
        <path d={setTicks} />
        <circle cx={f2(C0[0])} cy={f2(C0[1])} r="1.6" />
      </g>
      <path class="solid" d={solidBand} />
      <path class="solid" d={solidFace} fill-rule="evenodd" />
      <g class="hatch-in">
        <path d={hatchInner.join('')} />
      </g>
      <g class="hatch-out">{hatchOuter.map((d, k) => d && <path d={d} style={`stroke-opacity:${TONES[k]}`} />)}</g>
      <g class="back">
        <path d={backInner} />
        <path d={innerSil.join('')} />
      </g>
      <g class="edge">
        <path d={backOuter} />
        <path d={outerSil.join('')} />
      </g>
      <g class="front">
        <path d={frontOuter} />
        <path d={frontInner} />
      </g>
      <g class="bevel">
        <path d={bevelOuter} />
        <path d={bevelInner} />
      </g>
      <g class="channel">
        <path d={rails} />
        <path d={railEnds} />
      </g>
      <g class="stones">
        {
          stones.map((s) => (
            <g style={`opacity:${s.o}`}>
              <path class="girdle" d={s.girdle} />
              <path class="step" d={s.step} />
              <path class="corners" d={s.corners} />
              <path class="table" d={s.table} />
            </g>
          ))
        }
      </g>
      {
        !compact && (
          <g class="notes" aria-hidden="true">
            {notes.map((n) => (
              <>
                <path class="leader" d={pathOf([n.at, n.to, [n.to[0] + (n.anchor === 'start' ? 8 : -8), n.to[1]]])} />
                <circle class="dot" cx={f2(n.at[0])} cy={f2(n.at[1])} r="1.5" />
                <text x={f2(n.to[0] + (n.anchor === 'start' ? 12 : -12))} y={f2(n.to[1] + 4)} text-anchor={n.anchor}>
                  {n.text}
                </text>
              </>
            ))}
          </g>
        )
      }
    </svg>
    {!compact && <figcaption class="caption">Illustrative study, not a product image.</figcaption>}
  </figure>

  {
    compact ? (
      <p class="release">Current release: the Orchid ring, ten pieces, allocated by draw.</p>
    ) : (
      <div class="body">
        <p class="release">Current release: the Orchid ring in 18ct gold and emerald baguettes. Ten pieces, allocated by draw.</p>
        <p class="verify">Every piece carries a code you can verify.</p>
        <p class="links">
          <a href={RELEASE}>See the release</a>
          <a href={HOUSE}>theorbes.com</a>
        </p>
      </div>
    )
  }
  </div>
</article>

<style>
  .plate {
    --ink: var(--orbes-text);
    --soft: color-mix(in srgb, var(--orbes-text) 64%, transparent);
    --faint: color-mix(in srgb, var(--orbes-text) 16%, transparent);

    container-type: inline-size;
    position: relative;
    isolation: isolate;
    margin: 0;
    background: var(--plate-orbes);
    color: var(--ink);
    font-family: var(--font-ui);
    font-stretch: 100%;
    font-variant-numeric: lining-nums;
    line-height: 1.5;
    box-shadow:
      0 22px 40px -22px rgb(0 0 0 / 0.55),
      0 3px 8px -4px rgb(0 0 0 / 0.28),
      inset 0 1px 0 color-mix(in srgb, var(--orbes-text) 12%, transparent);
  }

  /* Plate mark: the paper edge a few pixels inside the print. */
  .plate::after {
    content: '';
    position: absolute;
    inset: 6px;
    border: 1px solid color-mix(in srgb, var(--orbes-text) 14%, transparent);
    pointer-events: none;
  }

  .inner {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: clamp(1.25rem, 5cqi, 2rem);
    padding: clamp(1.25rem, 6.5cqi, 3rem);
  }

  .plate--compact .inner {
    gap: clamp(1rem, 4.5cqi, 1.5rem);
    padding: clamp(1.1rem, 6cqi, 2rem);
  }

  /* ---------------- head */

  .head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.5rem 1.5rem;
  }

  .mark {
    margin: 0;
    font-family: var(--font-ui);
    font-stretch: 125%;
    font-weight: 400;
    font-size: clamp(1.375rem, 7cqi, 2.5rem);
    letter-spacing: 0.42em;
    margin-right: -0.42em;
    line-height: 1;
    color: var(--ink);
  }

  .plate--compact .mark {
    font-size: clamp(1.25rem, 7.5cqi, 1.875rem);
  }

  .place {
    font-stretch: 112%;
    font-size: 0.8125rem;
    letter-spacing: 0.06em;
    color: var(--soft);
  }

  /* ---------------- drawing */

  .ring {
    width: 100%;
    max-width: 28rem;
    margin: 0 auto;
    padding-block: clamp(0.25rem, 2cqi, 1rem);
  }

  .ring svg {
    display: block;
    width: 100%;
    height: auto;
    overflow: visible;
  }

  /* Narrow: the notes are hidden, so crop away the margin they would use. */
  @container (max-width: 459px) {
    .ring {
      overflow: hidden;
    }
    .ring svg {
      max-width: none;
      width: calc(100% / (1 - var(--crop, 0)));
      margin-left: calc(-100% * var(--crop, 0) / (1 - var(--crop, 0)));
    }
  }

  .ring path,
  .ring circle {
    fill: none;
    stroke: var(--ink);
    stroke-linecap: round;
    stroke-linejoin: round;
    vector-effect: non-scaling-stroke;
  }

  .ring .solid {
    fill: var(--plate-orbes);
    stroke: none;
  }

  .construct path,
  .construct circle {
    stroke-opacity: 0.26;
    stroke-width: 0.6;
    stroke-dasharray: 2 3;
  }
  .construct .dashdot {
    stroke-dasharray: 14 3 1.5 3;
  }

  .hatch-in path {
    stroke-opacity: 0.2;
    stroke-width: 0.55;
  }
  .hatch-out path {
    stroke-width: 0.55;
  }

  .back path {
    stroke-opacity: 0.46;
    stroke-width: 0.8;
  }
  .edge path {
    stroke-opacity: 0.9;
    stroke-width: 1.05;
  }
  .front path {
    stroke-width: 1.25;
  }
  .bevel path {
    stroke-opacity: 0.3;
    stroke-width: 0.6;
  }
  .channel path {
    stroke-opacity: 0.7;
    stroke-width: 0.75;
  }

  .stones .girdle {
    fill: var(--plate-orbes);
    stroke-width: 1;
  }
  .stones .step {
    stroke-opacity: 0.55;
    stroke-width: 0.6;
  }
  .stones .corners {
    stroke-opacity: 0.55;
    stroke-width: 0.55;
  }
  .stones .table {
    fill: color-mix(in srgb, var(--orbes-text) 7%, transparent);
    stroke-width: 0.8;
  }

  .notes .leader {
    stroke-opacity: 0.5;
    stroke-width: 0.6;
  }
  .notes .dot {
    fill: var(--ink);
    stroke: none;
  }
  .notes text {
    fill: var(--ink);
    fill-opacity: 0.72;
    font-family: var(--font-ui);
    font-stretch: 112%;
    font-size: 12px;
    letter-spacing: 0.04em;
  }

  @container (max-width: 459px) {
    .notes {
      display: none;
    }
  }

  .caption {
    margin-top: 0.5rem;
    font-size: 0.75rem;
    line-height: 1.3;
    text-align: right;
    color: var(--soft);
  }

  /* ---------------- text */

  .body {
    display: grid;
    gap: 0.8rem;
    align-content: end;
  }

  .release {
    max-width: 30em;
    font-size: clamp(1rem, 3.1cqi, 1.1875rem);
    font-weight: 380;
    line-height: 1.45;
    color: var(--ink);
    text-wrap: pretty;
  }

  .verify {
    font-size: 0.875rem;
    color: var(--soft);
  }

  .plate--compact .release {
    font-size: 0.9375rem;
    color: var(--soft);
  }

  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.75rem;
    margin-top: 0.5rem;
  }

  .plate a {
    color: var(--ink);
    background-image: none;
    text-decoration-line: underline;
