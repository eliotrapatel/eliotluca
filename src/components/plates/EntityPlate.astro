---
// THE ENTITY, tipped in as a plate in the venture's own identity: near-black
// stock, teal accent. The chain graph is a schematic drawn from a seeded
// generator, so the output is the same on every build.
interface Props {
  size?: 'feature' | 'compact';
}
const { size = 'feature' } = Astro.props;
const compact = size === 'compact';

const HREF = 'https://joinentity.com';

// Bottom to top: the stack the AI economy stands on.
const LAYERS = ['Energy', 'Chips', 'Infrastructure', 'Models', 'Applications'];

const FIGURES = [
  { n: '835', label: 'companies mapped' },
  { n: '80', label: 'chain nodes' },
  { n: '2,808', label: 'calibrated links' },
  { n: '103', label: 'elite funds tracked' },
  { n: '624', label: 'geolocated facilities' },
];
const figures = compact ? FIGURES.slice(0, 3) : FIGURES;

type Node = { x: number; y: number; layer: number; choke: boolean };
type Link = { a: Node; b: Node; choke: boolean };

function mulberry32(seed: number) {
  let t = seed >>> 0;
  return () => {
    t = (t + 0x6d2b79f5) >>> 0;
    let r = Math.imul(t ^ (t >>> 15), 1 | t);
    r = (r + Math.imul(r ^ (r >>> 7), 61 | r)) ^ r;
    return ((r ^ (r >>> 14)) >>> 0) / 4294967296;
  };
}

const r1 = (v: number) => Math.round(v * 10) / 10;

interface LayoutSpec {
  seed: number;
  counts: number[]; // nodes per layer, bottom to top
  x0: number;
  x1: number;
  rows: number[]; // y per layer, bottom to top
  chokes: [number, number][]; // [layer, index]
}

function layout(spec: LayoutSpec) {
  const rand = mulberry32(spec.seed);
  const layers: Node[][] = spec.counts.map((n, L) => {
    const span = (spec.x1 - spec.x0) / n;
    return Array.from({ length: n }, (_, i) => ({
      x: r1(spec.x0 + (i + 0.5) * span + (rand() - 0.5) * span * 0.42),
      y: r1(spec.rows[L] + (rand() - 0.5) * 7),
      layer: L,
      choke: false,
    }));
  });
  for (const [L, i] of spec.chokes) layers[L][i].choke = true;

  const links: Link[] = [];
  const seen = new Set<string>();
  const add = (a: Node, b: Node) => {
    const k = `${a.x},${a.y}|${b.x},${b.y}`;
    if (seen.has(k)) return;
    seen.add(k);
    links.push({ a, b, choke: a.choke || b.choke });
  };

  for (let L = 0; L < layers.length - 1; L++) {
    const lo = layers[L];
    const hi = layers[L + 1];
    for (const a of lo) {
      // A chokepoint feeds much of the layer above it; an ordinary node a few
      // neighbours.
      const k = a.choke ? 4 + Math.floor(rand() * 2) : 1 + Math.floor(rand() * 2.4);
      const near = [...hi].sort((p, q) => Math.abs(p.x - a.x) - Math.abs(q.x - a.x));
      near.slice(0, k).forEach((b) => add(a, b));
    }
    // Every node above draws on at least one node below.
    for (const b of hi) {
      if (!links.some((l) => l.b === b)) {
        const a = [...lo].sort((p, q) => Math.abs(p.x - b.x) - Math.abs(q.x - b.x))[0];
        add(a, b);
      }
    }
    // A node above a chokepoint layer leans on the chokepoint too.
    for (const b of hi) {
      if (b.choke) {
        const below = [...lo].sort((p, q) => Math.abs(p.x - b.x) - Math.abs(q.x - b.x));
        below.slice(0, 3).forEach((a) => add(a, b));
      }
    }
  }

  const nodes = layers.flat();
  const path = (l: Link) => {
    const my = r1((l.a.y + l.b.y) / 2);
    return `M${l.a.x} ${l.a.y}C${l.a.x} ${my} ${l.b.x} ${my} ${l.b.x} ${l.b.y}`;
  };
  return {
    nodes,
    plain: links.filter((l) => !l.choke).map(path),
    choke: links.filter((l) => l.choke).map(path),
  };
}

// Wide sheet: layer names in a column to the left, layers as rows.
const wideRows = [262, 201, 140, 79, 18];
const wide = layout({
  seed: 2808,
  counts: [6, 9, 10, 8, 11],
  x0: 8,
  x1: 552,
  rows: wideRows,
  chokes: [
    [0, 3],
    [1, 2],
    [1, 6],
    [2, 4],
  ],
});

// Narrow sheet: layer names sit above each row, nodes use the full width.
const narrowRows = [302, 237, 172, 107, 42];
const narrow = layout({
  seed: 835,
  counts: [5, 6, 7, 6, 8],
  x0: 4,
  x1: 336,
  rows: narrowRows,
  chokes: [
    [0, 2],
    [1, 1],
    [1, 4],
    [2, 3],
  ],
});

const charts = [
  { cls: 'chart--wide', w: 560, h: 280, rows: wideRows, data: wide, labelAt: (y: number) => y, r: 3.4, core: 3.7, ring: 7.4 },
  { cls: 'chart--narrow', w: 340, h: 314, rows: narrowRows, data: narrow, labelAt: (y: number) => y - 21, r: 3.3, core: 3.6, ring: 7.4 },
];
// Every ordinary node in one path: a circle is two half arcs.
const dots = (ns: Node[], r: number) =>
  ns.map((n) => `M${r1(n.x - r)} ${n.y}a${r} ${r} 0 1 0 ${2 * r} 0a${r} ${r} 0 1 0 ${-2 * r} 0`).join('');
const pct = (v: number, of: number) => `${((v / of) * 100).toFixed(3)}%`;

const graphLabel =
  'Schematic of the AI supply chain in five layers, from energy at the base through chips, infrastructure and models to applications. Fine curved links join each layer to the next; four nodes are marked as chokepoints, each feeding much of the layer above.';
---

<article class:list={['plate', `plate--${size}`]} aria-label="THE ENTITY">
  <div class="inner">
  <header class="head">
    {
      compact ? (
        <a class="mark" href={HREF}>
          THE ENTITY
        </a>
      ) : (
        <p class="mark">THE ENTITY</p>
      )
    }
    {!compact && <p class="claim">The institutional-grade map of the AI supply chain.</p>}
  </header>

  <div class="graph">
    {
      charts.map((c) => (
        <div class:list={['chart', c.cls]}>
          <ol class="layers" aria-hidden="true">
            {LAYERS.map((name, L) => (
              <li style={`top:${pct(c.labelAt(c.rows[L]), c.h)}`}>{name}</li>
            ))}
          </ol>
          <svg viewBox={`0 0 ${c.w} ${c.h}`} role="img" aria-label={graphLabel}>
            <title>{graphLabel}</title>
            <g aria-hidden="true">
              {c.rows.map((y) => (
                <line class="row-rule" x1="0" y1={y} x2={c.w} y2={y} />
              ))}
            </g>
            <path class="link" d={c.data.plain.join('')} />
            <path class="link link--choke" d={c.data.choke.join('')} />
            <path class="node" d={dots(c.data.nodes.filter((n) => !n.choke), c.r)} />
            {c.data.nodes
              .filter((n) => n.choke)
              .map((n) => (
                <>
                  <circle class="choke-ring" cx={n.x} cy={n.y} r={c.ring} />
                  <circle class="choke-core" cx={n.x} cy={n.y} r={c.core} />
                </>
              ))}
          </svg>
        </div>
      ))
    }

    <p class="legend">
      <span class="key">
        <svg viewBox="0 0 16 16" aria-hidden="true"><circle class="node" cx="8" cy="8" r="3.4" /></svg>
        Chain node
      </span>
      <span class="key">
        <svg viewBox="0 0 16 16" aria-hidden="true">
          <circle class="choke-ring" cx="8" cy="8" r="6.6" />
          <circle class="choke-core" cx="8" cy="8" r="3.2" />
        </svg>
        Chokepoint
      </span>
      <span class="key key--note">Schematic: a sample of nodes, positions illustrative.</span>
    </p>
  </div>

  <dl class:list={['figures', { 'figures--three': compact }]}>
    {
      figures.map((f) => (
        <div class="fig">
          <dt>{f.label}</dt>
          <dd>{f.n}</dd>
        </div>
      ))
    }
  </dl>

  {
    !compact && (
      <footer class="foot">
        <a class="open" href={HREF}>
          Open THE ENTITY
        </a>
        <p class="fine">Model 2.8. Educational analysis, not investment advice.</p>
      </footer>
    )
  }
  </div>
</article>

<style>
  .plate {
    --ink: var(--entity-text);
    --accent: var(--entity-teal);
    --soft: color-mix(in srgb, var(--entity-text) 66%, transparent);
    --faint: color-mix(in srgb, var(--entity-text) 16%, transparent);

    container-type: inline-size;
    position: relative;
    isolation: isolate;
    margin: 0;
    background: var(--plate-entity);
    color: var(--ink);
    font-family: var(--font-ui);
    font-stretch: 100%;
    font-variant-numeric: lining-nums tabular-nums;
    line-height: 1.45;
    box-shadow:
      0 22px 40px -22px rgb(0 0 0 / 0.55),
      0 3px 8px -4px rgb(0 0 0 / 0.28),
      inset 0 1px 0 color-mix(in srgb, var(--entity-text) 12%, transparent);
  }

  /* Plate mark: the paper edge a few pixels inside the print. */
  .plate::after {
    content: '';
    position: absolute;
    inset: 6px;
    border: 1px solid color-mix(in srgb, var(--entity-text) 13%, transparent);
    pointer-events: none;
  }

  .inner {
    display: grid;
    gap: clamp(1.25rem, 4.5cqi, 2rem);
    padding: clamp(1.25rem, 6cqi, 2.75rem);
  }

  .plate--compact .inner {
    gap: clamp(1rem, 4cqi, 1.5rem);
    padding: clamp(1.1rem, 5.5cqi, 1.75rem);
  }

  /* ---------------- head */

  .head {
    display: grid;
    gap: 0.7rem;
  }

  .mark {
    margin: 0;
    justify-self: start;
    font-size: clamp(0.9375rem, 3.2cqi, 1.125rem);
    font-weight: 620;
    letter-spacing: 0.16em;
    margin-right: -0.16em;
    line-height: 1;
    color: var(--ink);
  }

  .claim {
    max-width: 22em;
    font-size: clamp(1.3125rem, 4.4cqi, 2rem);
    font-weight: 380;
    line-height: 1.16;
    letter-spacing: -0.012em;
    color: var(--ink);
    text-wrap: balance;
  }

  /* ---------------- graph */

  .graph {
    display: grid;
    gap: 1.15rem;
  }

  .chart {
    position: relative;
  }

  .chart svg {
    display: block;
    width: 100%;
    height: auto;
    overflow: visible;
  }

  .chart--wide {
    display: none;
    padding-left: 8.25rem;
  }

  @container (min-width: 600px) {
    .chart--wide {
      display: block;
    }
    .chart--narrow {
      display: none;
    }
  }

  .layers {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .layers li {
    position: absolute;
    left: 0;
    transform: translateY(-50%);
    font-size: 0.8125rem;
    font-weight: 450;
    line-height: 1;
    letter-spacing: 0.01em;
    color: var(--soft);
    white-space: nowrap;
  }

  /* Above the rows, a name masks the links that pass behind it. */
  .chart--narrow .layers li {
    padding-right: 0.45em;
    background: var(--plate-entity);
  }

  .row-rule {
    stroke: var(--ink);
    stroke-opacity: 0.1;
    stroke-width: 1;
    stroke-dasharray: 1 4;
    vector-effect: non-scaling-stroke;
  }

  .link {
    fill: none;
    stroke: var(--ink);
    stroke-opacity: 0.2;
    stroke-width: 0.75;
    vector-effect: non-scaling-stroke;
  }

  .link--choke {
    stroke: var(--accent);
    stroke-opacity: 0.62;
    stroke-width: 0.9;
  }

  .node {
    fill: var(--plate-entity);
    stroke: var(--ink);
    stroke-opacity: 0.78;
    stroke-width: 1;
    vector-effect: non-scaling-stroke;
  }

  .choke-ring {
    fill: var(--plate-entity);
    stroke: var(--accent);
    stroke-width: 1;
    vector-effect: non-scaling-stroke;
  }

  .choke-core {
    fill: var(--accent);
    stroke: none;
  }

  .legend {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.35rem 1.25rem;
    font-size: 0.8125rem;
    line-height: 1.3;
    color: var(--soft);
  }

  .key {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
  }

  .key svg {
    width: 16px;
    height: 16px;
    flex: none;
  }

  .key--note {
    flex-basis: 100%;
  }

  @container (min-width: 620px) {
    .key--note {
      flex-basis: auto;
      margin-left: auto;
    }
  }

  .plate--compact .legend {
    display: none;
  }

  /* ---------------- figures */

  .figures {
    margin: 0;
    display: grid;
    grid-template-columns: 1fr;
    border-top: 1px solid var(--faint);
  }

  .fig {
    display: flex;
    flex-direction: row-reverse;
    justify-content: flex-end;
    align-items: baseline;
    gap: 0.9rem;
    padding: 0.6rem 0;
    border-bottom: 1px solid var(--faint);
  }

  .fig dd {
    margin: 0;
    min-width: 3.3em;
    font-size: 1.5rem;
    font-weight: 420;
    line-height: 1.1;
    letter-spacing: -0.01em;
    color: var(--ink);
  }

  .fig dt {
    font-size: 0.875rem;
    line-height: 1.3;
    color: var(--soft);
  }

  @container (min-width: 560px) {
    .fig dd {
      order: -1;
    }
    .figures {
      grid-template-columns: repeat(5, minmax(0, 1fr));
      border-bottom: 1px solid var(--faint);
    }
    .fig {
      flex-direction: column;
      justify-content: flex-start;
      align-items: flex-start;
      gap: 0.4rem;
      padding: 0.95rem 0.9rem 1rem;
      border-bottom: 0;
      border-left: 1px solid var(--faint);
    }
    .fig:first-child {
      border-left: 0;
      padding-left: 0;
    }
    .fig dd {
      min-width: 0;
      font-size: clamp(1.5rem, 4.4cqi, 2.375rem);
      font-weight: 380;
    }
    .fig dt {
      font-size: 0.8125rem;
    }
  }

  /* Compact: three figures always in a row. */
  .figures--three {
    grid-template-columns: repeat(3, minmax(0, 1fr));
    border-bottom: 1px solid var(--faint);
  }
  .figures--three .fig {
    flex-direction: column;
    justify-content: flex-start;
    align-items: flex-start;
    gap: 0.3rem;
    padding: 0.75rem 0.7rem 0.8rem;
    border-bottom: 0;
    border-left: 1px solid var(--faint);
  }
  .figures--three .fig dd {
    order: -1;
  }
  .figures--three .fig:first-child {
    border-left: 0;
    padding-left: 0;
  }
  .figures--three .fig dd {
    min-width: 0;
    font-size: clamp(1.25rem, 5.6cqi, 1.75rem);
  }
  .figures--three .fig dt {
    font-size: 0.8125rem;
  }

  /* ---------------- foot */

  .foot {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.75rem 1.5rem;
  }

  .fine {
    font-size: 0.8125rem;
    color: var(--soft);
  }

  /* Links take the plate's own ink, not the sheet's. */
  .plate a {
    color: var(--ink);
    background-image: none;
    text-decoration-line: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.3em;
    text-decoration-color: var(--accent);
    transition:
      color 160ms var(--ease-out),
      text-decoration-color 160ms var(--ease-out);
  }

  .open {
    font-size: 1rem;
    font-weight: 520;
  }

  .plate a:hover {
    color: var(--accent);
    text-decoration-thickness: 2px;
  }

  .plate a:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 4px;
  }

  .plate a.mark {
    text-decoration-color: var(--faint);
    text-underline-offset: 0.45em;
  }
</style>
