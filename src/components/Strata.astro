---
// Disciplines by year of entry: one rule from 2016 to now, one line per
// discipline from the year it began (broken where a discipline was set aside). Each row is tied to its drawing on the
// sheet through data-study, so hovering one lights the other.
import { disciplines as allDisciplines } from '../data/site';
import { essayHref } from '../lib/writing';

interface Props {
  linkStudies?: boolean;
}
const { linkStudies = true } = Astro.props;

const disciplines = await Promise.all(allDisciplines.map(async (d) => ({ ...d, href: await essayHref(d.href) })));
const START = 2016;
const END = 2027;
const span = END - START;
const today = new Date();
const nowYear = today.getUTCFullYear() + today.getUTCMonth() / 12 + today.getUTCDate() / 365;
const nowFrac = Math.min(1, (nowYear - START) / span);
const years = Array.from({ length: span }, (_, i) => START + i);
const nowLabel = new Intl.DateTimeFormat('en-GB', { month: 'long', year: 'numeric', timeZone: 'UTC' }).format(today);
const totalYears = Math.floor(nowYear - START);
---

<figure class="strata" style={`--now: ${nowFrac}`} data-start={START} data-span={span}>
  <figcaption class="cap">
    <span class="t-dim legend">Each line runs from the year a discipline began to <span class="now-month">{nowLabel}</span>. A gap is a pause.</span>
  </figcaption>

  <div class="chart">
    <div class="axis t-dim" aria-hidden="true">
      {
        years.map((y) => (
          <span class="tick" style={`--x: ${(y - START) / span}`}>
            {y}
          </span>
        ))
      }
    </div>

    <ol class="rows">
      {
        disciplines.map((d) => (
          <li class="row" data-study={linkStudies ? d.study : undefined} style={`--a: ${(d.since - START) / span}`}>
            <a class="name" href={d.href}>
              <span class="label">{d.name.replace('E-', 'E\u2011')}</span>
              <span class="since t-dim">{d.pause ? `${d.since} to ${d.pause[0]}, ${d.pause[1]}` : `since ${d.since}`}</span>
            </a>
            <span class="track" aria-hidden="true">
              {d.pause ? (
                <>
                  <span class="line is-closed" style={`--b: ${(d.pause[0] - START) / span}`} />
                  <span class="line" style={`--a: ${(d.pause[1] - START) / span}`} />
                </>
              ) : (
                <span class="line" />
              )}
            </span>
          </li>
        ))
      }
    </ol>
    <span class="now-rule" aria-hidden="true" />
  </div>
</figure>

<style>
  .strata {
    margin: 0;
    --name: 17rem;
  }

  .cap {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: baseline;
    gap: var(--s1) var(--s4);
    padding-bottom: var(--s3);
  }

  .cap .t-note {
    font-size: var(--step-2);
  }

  .legend {
    font-size: var(--step--2);
    color: var(--line-2);
  }

  .chart {
    position: relative;
    border-top: 1px solid var(--border-2);
  }

  .axis {
    position: relative;
    height: 2.25rem;
    margin-left: var(--name);
    font-size: 0.75rem;
    color: var(--line-2);
  }

  .tick {
    position: absolute;
    top: 0.7rem;
    left: calc(var(--x) * 100%);
    transform: translateX(-50%);
  }

  .tick::before {
    content: '';
    position: absolute;
    left: 50%;
    top: -0.7rem;
    height: 0.45rem;
    border-left: 1px solid var(--line);
  }

  .rows {
    list-style: none;
  }

  .row {
    display: grid;
    grid-template-columns: var(--name) minmax(0, 1fr);
    align-items: center;
    min-height: 2.6rem;
    border-top: 1px solid var(--rule);
  }

  .name {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.75rem;
    padding-right: var(--s3);
    padding-block: 0.45rem;
    font-size: var(--step-0);
    text-decoration: none;
    background: none;
  }

  .since {
    font-size: 0.75rem;
    color: var(--line-2);
    white-space: nowrap;
  }

  .track {
    position: relative;
    align-self: stretch;
  }

  .line {
    position: absolute;
    top: 50%;
    left: calc(var(--a) * 100%);
    right: calc((1 - var(--now)) * 100%);
    height: 1px;
    background: var(--line);
    transition: box-shadow 200ms var(--ease-out);
  }

  .line::before {
    content: '';
    position: absolute;
    left: -4px;
    top: -4px;
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: var(--ground);
    border: 1.25px solid var(--line);
  }

  /* A stretch that ended: the line stops at the year it was set aside. */
  .line.is-closed {
    right: calc((1 - var(--b)) * 100%);
  }

  .line.is-closed::after {
    content: '';
    position: absolute;
    right: -1px;
    top: -4px;
    height: 9px;
    border-left: 1.25px solid var(--line);
  }

  .now-rule {
    position: absolute;
    top: 0;
    bottom: 0;
    left: calc(var(--name) + (100% - var(--name)) * var(--now));
    border-left: 1px solid var(--line);
    pointer-events: none;
  }

  .now-rule::before {
    content: 'Now';
    position: absolute;
    top: 0.62rem;
    left: 0.45rem;
    font-family: var(--font-text);
    font-style: italic;
    font-size: var(--step--1);
    color: var(--line);
  }

  .row:hover .line,
  .row.is-lit .line {
    box-shadow: 0 -1.5px 0 var(--line), 0 1.5px 0 var(--line);
  }

  .row:hover .label,
  .row.is-lit .label {
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.2em;
  }

  @media (max-width: 760px) {
    .strata {
      --name: 0rem;
    }
    .axis {
      margin-left: 0;
    }
    .tick:nth-child(even) {
      visibility: hidden;
    }
    .tick:first-child {
      transform: none;
    }
    .tick:last-child {
      visibility: hidden;
    }
    .tick:first-child::before {
      left: 0;
    }
    .now-rule::before {
      left: auto;
      right: 0.45rem;
    }
    .row {
      grid-template-columns: 1fr;
      padding-bottom: 0.7rem;
    }
    .name {
      padding-right: 3.2rem;
      justify-content: flex-start;
    }
    .track {
      height: 12px;
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    :global(.can-draw body[data-draw]) .line {
      transform-origin: left center;
      transform: scaleX(0);
      animation: grow 1100ms var(--ease-out) forwards;
      animation-delay: 900ms;
    }
  }

  @keyframes grow {
    to {
      transform: none;
    }
  }
</style>

<script>
  // The page is static; keep "now" honest between deploys.
  document.querySelectorAll<HTMLElement>('figure.strata').forEach((fig) => {
    const start = Number(fig.dataset.start);
    const span = Number(fig.dataset.span);
    const d = new Date();
    const y = d.getFullYear() + d.getMonth() / 12 + d.getDate() / 365;
    fig.style.setProperty('--now', String(Math.min(1, Math.max(0, (y - start) / span))));
    const label = fig.querySelector('.now-month');
    if (label) label.textContent = new Intl.DateTimeFormat('en-GB', { month: 'long', year: 'numeric' }).format(d);
  });
</script>
