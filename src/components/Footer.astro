---
import { site } from '../data/site';

const elsewhere = [
  { label: 'THE ENTITY', href: 'https://joinentity.com' },
  { label: 'ORBES', href: 'https://theorbes.com' },
  { label: 'LinkedIn', href: site.social.linkedin },
  { label: 'X', href: site.social.x },
  { label: 'GitHub', href: site.social.github },
  { label: 'Instagram', href: site.social.instagram },
].filter((l) => l.href);

const pages = [
  { label: 'Ventures', href: '/work' },
  { label: 'Writing', href: '/writing' },
  { label: 'Instruments', href: '/instruments' },
  { label: 'About', href: '/about' },
  { label: 'Now', href: '/now' },
  { label: 'Links', href: '/links' },
];

const year = new Date().getFullYear();
---

<footer class="foot" id="contact" lang="en">
  <div class="wrap">
    <div class="cta">
      <p class="t-label">For a deal, a product or a piece</p>
      <a class="mail t-title" href={`mailto:${site.email}`}>{site.email}</a>
    </div>

    <div class="cols">
      <div class="brand">
        <p class="word t-title">Eliot Luca</p>
        <p class="muted small">Capital, code and craft. Paris.</p>
      </div>
      <nav aria-label="On this site">
        <p class="t-label">Site</p>
        <ul>{pages.map((l) => <li><a href={l.href}>{l.label}</a></li>)}</ul>
      </nav>
      <nav aria-label="Elsewhere">
        <p class="t-label">Elsewhere</p>
        <ul>
          {
            elsewhere.map((l) => (
              <li>
                <a href={l.href} rel="me noopener">
                  {l.label}
                </a>
              </li>
            ))
          }
          <li><a href="/rss.xml">RSS</a></li>
        </ul>
      </nav>
      <div class="time">
        <p class="t-label">Paris</p>
        <p class="clock t-title"><span data-clock="Europe/Paris">--:--</span></p>
      </div>
    </div>

    <p class="legal t-label">
      <span>© {year} {site.name}</span>
      <span>eliotluca.com</span>
    </p>
  </div>
</footer>

<style>
  .foot {
    margin-top: var(--s8);
    padding-bottom: var(--s4);
  }

  .foot {
    border-top: 1px solid var(--rule);
    padding-top: var(--s6);
  }

  .mail {
    display: inline-block;
    margin-top: var(--s2);
    font-size: var(--step-5);
    text-decoration-color: rgb(205 182 138 / 0.45);
    text-underline-offset: 0.16em;
    overflow-wrap: anywhere;
  }

  .mail:hover {
    text-decoration-color: var(--gold);
  }

  .cols {
    display: grid;
    grid-template-columns: 2fr 1fr 1fr 1fr;
    gap: var(--s4);
    margin-top: var(--s6);
    font-size: var(--step--1);
  }

  .word {
    letter-spacing: 0.2em;
    text-transform: uppercase;
    font-size: 1rem;
  }

  .small {
    margin-top: 0.5rem;
  }

  ul {
    list-style: none;
    display: grid;
    gap: 0.5em;
    margin-top: var(--s2);
  }

  ul a {
    color: var(--line-2);
    text-decoration: none;
  }

  ul a:hover {
    color: var(--line);
  }

  .clock {
    margin-top: var(--s2);
    font-size: var(--step-3);
    color: var(--line);
  }

  .legal {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: var(--s1) var(--s4);
    margin-top: var(--s6);
    padding-top: var(--s3);
    border-top: 1px solid var(--rule);
  }

  @media (max-width: 760px) {
    .cols {
      grid-template-columns: 1fr 1fr;
    }
    .brand {
      grid-column: 1 / -1;
    }
  }
</style>
