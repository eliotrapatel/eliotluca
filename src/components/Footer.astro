---
import { site } from '../data/site';

const elsewhere = [
  { label: 'THE ENTITY', href: 'https://joinentity.com' },
  { label: 'ORBES', href: 'https://theorbes.com' },
  { label: 'LinkedIn', href: site.social.linkedin },
  { label: 'X', href: site.social.x },
  { label: 'GitHub', href: site.social.github },
  { label: 'Instagram', href: site.social.instagram },
].filter((l) => l.href);

const pages = [
  { label: 'Ventures', href: '/work' },
  { label: 'Writing', href: '/writing' },
  { label: 'Instruments', href: '/instruments' },
  { label: 'About', href: '/about' },
  { label: 'Now', href: '/now' },
  { label: 'Links', href: '/links' },
];

const year = new Date().getFullYear();
---

<footer class="foot" id="contact" lang="en">
  <div class="wrap">
    <div class="cta panel">
      <div class="cta-text">
        <p class="t-label">Contact</p>
        <h2 class="t-title cta-title">Let's talk. <span class="t-fade">A deal, a product or a piece.</span></h2>
      </div>
      <a class="btn btn-primary mail" href={`mailto:${site.email}`}>
        {site.email}
        <svg viewBox="0 0 14 14" aria-hidden="true"><path d="M3 11 11 3M5 3h6v6" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"></path></svg>
      </a>
    </div>

    <div class="cols">
      <div class="brand">
        <p class="word">Eliot Luca</p>
        <p class="muted small">Capital, code and craft. Paris.</p>
      </div>
      <nav aria-label="On this site">
        <p class="t-label">Site</p>
        <ul>{pages.map((l) => <li><a href={l.href}>{l.label}</a></li>)}</ul>
      </nav>
      <nav aria-label="Elsewhere">
        <p class="t-label">Elsewhere</p>
        <ul>
          {
            elsewhere.map((l) => (
              <li>
                <a href={l.href} rel="me noopener">
                  {l.label}
                </a>
              </li>
            ))
          }
          <li><a href="/rss.xml">RSS</a></li>
        </ul>
      </nav>
      <div class="time">
        <p class="t-label">Paris</p>
        <p class="clock t-mono"><span data-clock="Europe/Paris">--:--</span></p>
      </div>
    </div>

    <p class="legal t-label">
      <span>© {year} {site.name}</span>
      <span>eliotluca.com</span>
    </p>
  </div>
</footer>

<style>
  .foot {
    margin-top: var(--s8);
    padding-bottom: var(--s4);
  }

  .cta {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: var(--s4);
    padding: clamp(28px, 5vw, 56px);
    overflow: hidden;
  }

  .cta::before {
    content: '';
    position: absolute;
    inset: auto -10% -60% 30%;
    height: 120%;
    background: radial-gradient(closest-side, rgb(205 182 138 / 0.16), transparent);
    pointer-events: none;
  }

  .cta-title {
    margin-top: var(--s2);
    font-size: var(--step-5);
    max-width: 14em;
  }

  .mail {
    position: relative;
    font-size: var(--step-0);
    padding: 0.95em 1.4em;
  }

  .cols {
    display: grid;
    grid-template-columns: 2fr 1fr 1fr 1fr;
    gap: var(--s4);
    margin-top: var(--s6);
    font-size: var(--step--1);
  }

  .word {
    font-stretch: 125%;
    letter-spacing: 0.32em;
    text-transform: uppercase;
    font-size: 0.8125rem;
  }

  .small {
    margin-top: 0.5rem;
  }

  ul {
    list-style: none;
    display: grid;
    gap: 0.5em;
    margin-top: var(--s2);
  }

  ul a {
    color: var(--line-2);
    text-decoration: none;
  }

  ul a:hover {
    color: var(--line);
  }

  .clock {
    margin-top: var(--s2);
    font-size: var(--step-3);
    color: var(--line);
  }

  .legal {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: var(--s1) var(--s4);
    margin-top: var(--s6);
    padding-top: var(--s3);
    border-top: 1px solid var(--rule);
  }

  @media (max-width: 760px) {
    .cols {
      grid-template-columns: 1fr 1fr;
    }
    .brand {
      grid-column: 1 / -1;
    }
  }
</style>
