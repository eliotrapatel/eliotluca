---
import Instrument from '../../layouts/Instrument.astro';
import {
  DEFAULT_INPUT,
  SYSTEMS,
  SYSTEM_IDS,
  UK_ROWS,
  VIEW,
  compute,
  describe,
  drawing,
  fmtMm,
  toDiameter,
} from '../../lib/instruments/ring-sizes';

const parsed = toDiameter(DEFAULT_INPUT.by, DEFAULT_INPUT.value);
const result = compute(parsed.ok ? parsed.diameter : 17);
const sys = SYSTEMS[DEFAULT_INPUT.by];
---

<Instrument
  title="Ring sizes"
  lede="One finger, six sizing systems."
  description="Convert a ring size between inner diameter, inner circumference, US, UK, EU, French, Italian, Spanish, Swiss and Japanese sizes."
  family="Craft"
  slug="ring-sizes"
>
  <div class="instrument-grid" data-rings>
    <form class="controls" novalidate aria-label="Ring measurement">
      <fieldset class="group">
        <legend>Your measurement</legend>
        <label class="field">
          <span class="field-label">Measured as</span>
          <span class="field-input">
            <select name="by" id="rs-by">
              {
                SYSTEM_IDS.map((id) => (
                  <option value={id} selected={id === DEFAULT_INPUT.by}>
                    {SYSTEMS[id].label}
                  </option>
                ))
              }
            </select>
            <span class="unit chevron" aria-hidden="true">
              <svg viewBox="0 0 12 8" width="12" height="8"><path d="M1 1.5 L6 6.5 L11 1.5" /></svg>
            </span>
          </span>
        </label>

        <label class="field" data-num-field>
          <span class="field-label" id="rs-value-label">{sys.label}</span>
          <span class="field-input">
            <input
              type="text"
              inputmode="decimal"
              autocomplete="off"
              spellcheck="false"
              name="value"
              id="rs-value"
              value={DEFAULT_INPUT.value}
              aria-describedby="rs-value-err rs-value-hint"
            />
            <span class="unit" data-unit>{sys.unit}</span>
          </span>
          <span class="field-error" id="rs-value-err" hidden></span>
        </label>

        <label class="field" data-uk-field hidden>
          <span class="field-label">UK and Australia letter</span>
          <span class="field-input">
            <select name="uk" id="rs-uk" aria-describedby="rs-value-hint">
              {
                UK_ROWS.map((r) => (
                  <option value={r.value} selected={r.value === 'M.5'}>
                    {r.label}
                  </option>
                ))
              }
            </select>
            <span class="unit chevron" aria-hidden="true">
              <svg viewBox="0 0 12 8" width="12" height="8"><path d="M1 1.5 L6 6.5 L11 1.5" /></svg>
            </span>
          </span>
        </label>

        <p class="hint t-note" id="rs-value-hint">
          Accepts an inner diameter of roughly 12 to 25 mm. A comma works as the decimal point.
        </p>
      </fieldset>

      <div class="form-foot">
        <button type="button" class="action" data-reset>Reset</button>
        <p class="t-note muted status" data-status aria-live="polite"></p>
      </div>
    </form>

    <div class="readout" aria-live="polite">
      <dl class="figures">
        <div class="figure is-key">
          <dt>Inner diameter</dt>
          <dd><span data-out="diameter">{fmtMm(result.diameter)}</span> <span class="u">mm</span></dd>
        </div>
        <div class="figure">
          <dt>Inner circumference</dt>
          <dd><span data-out="circumference">{fmtMm(result.circumference)}</span> <span class="u">mm</span></dd>
        </div>
      </dl>

      <div class="ledger-wrap">
        <table class="ledger">
          <caption class="visually-hidden">Nearest size in each system, with that size's exact inner measurements</caption>
          <thead>
            <tr>
              <th scope="col">System</th>
              <th scope="col" class="num">Nearest size</th>
              <th scope="col" class="num">Circumference, mm</th>
              <th scope="col" class="num">Diameter, mm</th>
            </tr>
          </thead>
          <tbody data-rows>
            {
              result.rows.map((r) => (
                <tr data-row={r.id}>
                  <th scope="row">{r.system}</th>
                  <td class="num size">{r.size}</td>
                  <td class="num">{r.circ === null ? 'Off the scale' : fmtMm(r.circ)}</td>
                  <td class="num">{r.diameter === null ? 'Off the scale' : fmtMm(r.diameter)}</td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>

      <figure class="study readout-drawing">
        <svg viewBox={`0 0 ${VIEW.w} ${VIEW.h}`} role="img" aria-labelledby="rs-svg-title rs-svg-desc">
          <title id="rs-svg-title">The ring in plan and in section</title>
          <desc id="rs-svg-desc">{describe(result)}</desc>
          <g data-plot set:html={drawing(result)} />
        </svg>
        <figcaption class="t-note">
          Drawn to proportion. The band, 3 mm wide and 1.8 mm thick with a comfort profile, is there only to show the cut.
        </figcaption>
      </figure>
      <p class="note">
        The starting size of 17 mm is illustrative. Each nearest size carries its own exact measurements, so you can see
        how far it sits from yours.
      </p>
    </div>
  </div>

  <Fragment slot="method">
    <p>
      To measure at home, wrap a strip of paper around the base of the finger, mark where it overlaps, and read the length
      in millimetres: that is the inner circumference. Or lay a ring that already fits on a ruler and read the inside
      diameter at its widest. Measure at the end of the day, when fingers are warm, and twice.
    </p>
    <p>
      The conversions run through the inner diameter d. US and Canada: d = 11.63 + 0.8128 × size. ISO 8653, the EU and
      France: size = π × d, the circumference in millimetres. Italy, Spain and Switzerland: the circumference minus 40. UK
      and Australia follow BS 6820, where C is 40 mm round and each letter adds 1.25 mm. Japanese sizes follow no rule, so
      they come from a published table, interpolated between rows.
    </p>
    <p>
      Wide bands, from about 6 mm, usually need half a size more. Fingers swell with heat and shrink with cold, and
      knuckles can be larger than the base. Makers' tables differ from one another by up to about half a size, roughly
      0.4 mm of diameter, so confirm with the maker before ordering.
    </p>
  </Fragment>
</Instrument>

<style>
  .readout-drawing {
    margin: 0;
  }
  .field select {
    min-height: 44px;
  }
  .field-input input {
    min-height: 44px;
  }
  .chevron svg {
    fill: none;
    stroke: var(--line-2);
    stroke-width: 1.4;
  }
  .field-input:has(select) {
    position: relative;
  }
  .field-input:has(select) .chevron {
    pointer-events: none;
    align-self: center;
  }
  .hint {
    font-size: var(--step-0);
    color: var(--line-2);
    max-width: 30em;
  }
  .action {
    min-height: 44px;
  }
  .form-foot {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--s2);
  }
  .status {
    font-size: var(--step-0);
  }
  .figure dd .u {
    font-family: var(--font-ui);
    font-size: var(--step-0);
    color: var(--line-2);
    letter-spacing: 0;
  }
  .ledger-wrap {
    overflow-x: auto;
  }
  .ledger-wrap :global(th[scope='row']) {
    font-weight: 450;
    color: var(--line);
    border-bottom: 1px solid var(--rule);
    padding: 0.55em 0.6em 0.55em 0;
  }
  .ledger-wrap :global(td.size) {
    font-weight: 550;
    font-size: var(--step-0);
  }
  .readout.is-stale .figures,
  .readout.is-stale .ledger-wrap,
  .readout.is-stale .readout-drawing {
    opacity: 0.45;
  }
  @media (max-width: 480px) {
    .ledger-wrap :global(th),
    .ledger-wrap :global(td) {
      padding-right: 0.35em;
    }
    .ledger thead th {
      font-size: var(--step--2);
      vertical-align: bottom;
    }
  }
  [hidden] {
    display: none !important;
  }
</style>

<script>
  import {
    DEFAULT_INPUT,
    SYSTEMS,
    SYSTEM_IDS,
    UK_ROWS,
    compute,
    describe,
    drawing,
    fmtMm,
    toDiameter,
    valueIn,
    type SystemId,
  } from '../../lib/instruments/ring-sizes';

  const root = document.querySelector<HTMLElement>('[data-rings]');
  if (root) {
    const form = root.querySelector<HTMLFormElement>('form')!;
    const by = root.querySelector<HTMLSelectElement>('#rs-by')!;
    const value = root.querySelector<HTMLInputElement>('#rs-value')!;
    const uk = root.querySelector<HTMLSelectElement>('#rs-uk')!;
    const numField = root.querySelector<HTMLElement>('[data-num-field]')!;
    const ukField = root.querySelector<HTMLElement>('[data-uk-field]')!;
    const label = root.querySelector<HTMLElement>('#rs-value-label')!;
    const unit = root.querySelector<HTMLElement>('[data-unit]')!;
    const err = root.querySelector<HTMLElement>('#rs-value-err')!;
    const readout = root.querySelector<HTMLElement>('.readout')!;
    const rowsEl = root.querySelector<HTMLElement>('[data-rows]')!;
    const plot = root.querySelector<SVGGElement>('[data-plot]')!;
    const desc = root.querySelector<SVGDescElement>('#rs-svg-desc')!;
    const status = root.querySelector<HTMLElement>('[data-status]')!;

    let lastDiameter = 17;
    let everValid = false;

    const current = (): { id: SystemId; raw: string } => {
      const id = by.value as SystemId;
      return { id, raw: id === 'uk' ? uk.value : value.value };
    };

    const showSystem = (id: SystemId) => {
      const isUk = id === 'uk';
      numField.hidden = isUk;
      ukField.hidden = !isUk;
      label.textContent = SYSTEMS[id].label;
      unit.textContent = SYSTEMS[id].unit;
      value.inputMode = id === 'japan' ? 'numeric' : 'decimal';
    };

    const setError = (msg: string | null) => {
      const wrap = value.closest('.field-input');
      if (msg) {
        value.setAttribute('aria-invalid', 'true');
        wrap?.setAttribute('aria-invalid', 'true');
        err.textContent = msg;
        err.hidden = false;
      } else {
        value.removeAttribute('aria-invalid');
        wrap?.removeAttribute('aria-invalid');
        err.textContent = '';
        err.hidden = true;
      }
    };

    const esc = (s: string) => s.replace(/&/g, '&amp;').replace(/</g, '&lt;');

    const update = (persist = true) => {
      const { id, raw } = current();
      const p = toDiameter(id, raw);
      if (!p.ok) {
        setError(p.error);
        readout.classList.add('is-stale');
        // A shared link with a bad value never had a valid size of its own: say the readout is the default.
        status.textContent = everValid ? 'The readout shows the last valid size.' : 'The readout shows the illustrative size until this is fixed.';
        return;
      }
      everValid = true;
      setError(null);
      readout.classList.remove('is-stale');
      status.textContent = '';
      lastDiameter = p.diameter;

      const r = compute(p.diameter);
      root.querySelector('[data-out="diameter"]')!.textContent = fmtMm(r.diameter);
      root.querySelector('[data-out="circumference"]')!.textContent = fmtMm(r.circumference);
      rowsEl.innerHTML = r.rows
        .map(
          (row) =>
            `<tr data-row="${row.id}"><th scope="row">${esc(row.system)}</th><td class="num size">${esc(row.size)}</td><td class="num">${
              row.circ === null ? 'Off the scale' : fmtMm(row.circ)
            }</td><td class="num">${row.diameter === null ? 'Off the scale' : fmtMm(row.diameter)}</td></tr>`,
        )
        .join('');
      plot.innerHTML = drawing(r);
      desc.textContent = describe(r);

      if (persist) {
        const isDefault = id === DEFAULT_INPUT.by && raw.trim() === DEFAULT_INPUT.value;
        const qs = isDefault ? '' : `?${new URLSearchParams({ by: id, v: raw.trim() }).toString()}`;
        history.replaceState(null, '', `${location.pathname}${qs}`);
      }
    };

    // Read a shared size from the query string.
    const params = new URLSearchParams(location.search);
    const qBy = params.get('by') as SystemId | null;
    const qV = params.get('v');
    if (qBy && SYSTEM_IDS.includes(qBy)) {
      by.value = qBy;
      // A UK value must be one of the listed letters; otherwise the select would go blank
      // with its error out of sight. Without a value, carry the default finger across.
      const v = qV !== null && (qBy !== 'uk' || UK_ROWS.some((r) => r.value === qV)) ? qV : valueIn(qBy, lastDiameter);
      if (qBy === 'uk') uk.value = v;
      else value.value = v;
    }
    showSystem(by.value as SystemId);

    by.addEventListener('change', () => {
      const id = by.value as SystemId;
      // Carry the current finger across: show the same size in the new system.
      const finger = lastDiameter;
      const v = valueIn(id, finger);
      if (id === 'uk') uk.value = v;
      else value.value = v;
      showSystem(id);
      update();
      // Keep the measured finger, not the rounded size, so switching back and forth does not drift.
      lastDiameter = finger;
      // The Japanese table and the Italian scale are shorter than the accepted range: say why the field is empty.
      if (id === 'japan' && v === '') {
        setError('This finger is off the Japanese table, which runs from 1 to 27. Enter a Japanese size in that range, or choose another system.');
      }
      if (id === 'italy' && v === '') {
        setError('This finger is smaller than Italian size 1. Enter an Italian size from 1 to 39, or choose another system.');
      }
    });
    form.addEventListener('input', (e) => {
      if (e.target === by) return;
      update();
    });
    form.addEventListener('submit', (e) => e.preventDefault());

    root.querySelector('[data-reset]')!.addEventListener('click', () => {
      by.value = DEFAULT_INPUT.by;
      value.value = DEFAULT_INPUT.value;
      showSystem(DEFAULT_INPUT.by);
      update(false);
      history.replaceState(null, '', location.pathname);
      status.textContent = 'Back to the illustrative size.';
    });

    update(false);
  }
</script>
