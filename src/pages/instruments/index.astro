---
import Base from '../../layouts/Base.astro';
import PageHead from '../../components/PageHead.astro';
import InstrumentList from '../../components/InstrumentList.astro';
---

<Base title="Instruments" description="Working tools by Eliot Luca: liquidity pools, order profitability, buyout returns, dilution, AI bottlenecks and copilot economics, solids and watch beats." image="/og/instruments.png">
  <PageHead
    title="Instruments"
    lede="Tools I built for my own work. They run in your browser, keep nothing, and every setting can be shared as a link."
  />
  <section class="wrap" aria-label="All instruments">
    <InstrumentList headingLevel="h2" />
    <p class="note t-note">Defaults are illustrative. Each instrument explains its method and what it leaves out.</p>
  </section>
</Base>

<style>
  .note {
    margin-top: var(--s4);
    font-size: var(--step-1);
    color: var(--line-2);
  }
</style>
