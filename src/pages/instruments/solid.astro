---
import Instrument from '../../layouts/Instrument.astro';
import {
  HOME,
  SOLID_DEFAULTS,
  SOLID_FIELDS,
  SOLID_IDS,
  SOLIDS,
  VIEW,
  compute,
  counts,
  describe,
  drawing,
  figures,
  type SolidKey,
} from '../../lib/instruments/solid';

const d = SOLID_DEFAULTS;
const result = compute(d);
const figs = figures(result);
const rows = counts(result);

type Field = { key: SolidKey; label: string; unit: string; hint?: string };
const fields: Field[] = [
  { key: 'edge', label: 'Edge length', unit: 'mm' },
  { key: 'density', label: 'Density', unit: 'g/cm³', hint: 'Water is 1.00.' },
];
---

<Instrument
  title="Solid"
  lede="Seven solids to turn in your hand, with their measures and their weight."
  description="Turn seven solids, from the tetrahedron to Leonardo's rhombicuboctahedron, and read their surface, volume, circumscribed sphere and weight for any edge and density."
  family="Form"
  slug="solid"
>
  <div class="instrument-grid" data-solid>
    <form class="controls" novalidate aria-label="Solid, edge and density">
      <fieldset class="group">
        <legend id="sd-solid-label">Solid</legend>
        <div class="choice solid-choice" role="radiogroup" aria-labelledby="sd-solid-label">
          {
            SOLID_IDS.map((id) => (
              <label>
                <input type="radio" name="solid" value={id} checked={d.solid === id} />
                {SOLIDS[id].label}
              </label>
            ))
          }
        </div>
      </fieldset>

      <fieldset class="group">
        <legend>Edge and density</legend>
        {
          fields.map((f) => (
            <label class="field">
              <span class="field-label">{f.label}</span>
              <span class="field-input">
                <input
                  type="text"
                  inputmode="decimal"
                  autocomplete="off"
                  spellcheck="false"
                  name={f.key}
                  id={`sd-${f.key}`}
                  value={SOLID_FIELDS[f.key].text}
                  aria-describedby={f.hint ? `sd-${f.key}-hint sd-${f.key}-err` : `sd-${f.key}-err`}
                />
                <span class="unit">{f.unit}</span>
              </span>
              {f.hint && (
                <span class="field-hint t-note" id={`sd-${f.key}-hint`}>
                  {f.hint}
                </span>
              )}
              <span class="field-error" id={`sd-${f.key}-err`} hidden />
            </label>
          ))
        }
      </fieldset>

      <div class="form-foot">
        <button type="button" class="action" data-copy>Copy link</button>
        <button type="button" class="action" data-reset>Reset</button>
        <p class="t-note muted status" data-status aria-live="polite"></p>
      </div>
    </form>

    <div class="readout" aria-live="polite">
      <figure class="study readout-drawing solid-drawing" aria-live="off">
        <svg
          viewBox={`0 0 ${VIEW.w} ${VIEW.h}`}
          role="img"
          tabindex="0"
          aria-labelledby="sd-svg-title sd-svg-desc"
          aria-describedby="sd-turn"
          data-drawing
        >
          <title id="sd-svg-title">The solid as a wireframe, inside its circumscribed sphere</title>
          <desc id="sd-svg-desc">{describe(result)}</desc>
          <g data-plot set:html={drawing(result, HOME.yaw, HOME.pitch)} />
        </svg>
        <figcaption class="t-note" id="sd-turn">
          Drag to turn it, or focus the drawing and use the arrow keys. The gold point is the vertex nearest to you.
        </figcaption>
      </figure>

      <dl class="figures">
        {
          figs.map((f) => (
            <div class:list={['figure', { 'is-key': f.key }]} data-fig={f.id}>
              <dt>{f.label}</dt>
              <dd>{f.value}</dd>
              <small>{f.small}</small>
            </div>
          ))
        }
      </dl>

      <div class="ledger-wrap">
        <table class="ledger">
          <caption class="visually-hidden">Vertices, edges and faces of the solid on screen</caption>
          <tbody>
            {
              rows.map((c) => (
                <tr class:list={[{ 'is-total': c.total }]} data-count={c.id}>
                  <th scope="row">{c.label}</th>
                  <td>{c.detail}</td>
                  <td class="num">{c.value}</td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>

      <p class="note">
        The rhombicuboctahedron is the solid Leonardo drew for Luca Pacioli's De divina proportione, printed in 1509.
      </p>
    </div>
  </div>

  <Fragment slot="method">
    <p>
      Each of these solids is fixed by one length, its edge a. The surface area is a constant × a², the volume a constant
      × a³, and the radius of the circumscribed sphere a constant × a. The constants are exact. For the
      rhombicuboctahedron the area is (18 + 2√3) × a², the volume is (12 + 10√2) / 3 × a³ and the radius is √(5 + 2√2) /
      2 × a. The edge is entered in millimetres and converted to centimetres before it is squared and cubed, so the area
      reads in cm² and the volume in cm³. Weight is volume × density.
    </p>
    <p>
      The powers set how the measures scale. Doubling the edge multiplies the area by four and the volume by eight, so
      the same solid twice as wide weighs eight times as much in the same material.
    </p>
    <p>
      For every convex solid, vertices − edges + faces = 2. This is Euler's formula, and the table checks it for the
      solid on screen: the cube gives 8 − 12 + 6, the rhombicuboctahedron 24 − 48 + 26.
    </p>
    <p>
      The coordinates come from the standard constructions. The cube is every sign change of (1, 1, 1), and the
      tetrahedron takes four alternate corners of it. The octahedron is (1, 0, 0), the cuboctahedron (1, 1, 0) and the
      rhombicuboctahedron (1, 1, 1 + √2), each taken through its cyclic permutations and sign changes. The icosahedron is
      (0, 1, φ) treated the same way, where φ is the golden ratio, (1 + √5) / 2, and the dodecahedron adds (0, 1/φ, φ) to
      the corners of the cube. Edges are the pairs of vertices at the shortest distance, and faces are the planes that
      leave every vertex on one side. The page counts both and refuses to draw a solid whose counts do not match the
      known ones.
    </p>
    <p>
      The drawing uses a light perspective and is scaled to the sphere, so it does not grow with the edge. The dotted
      circle is the outline of the circumscribed sphere, and edges on the far side are drawn fainter.
    </p>
    <p>
      Five of the seven are the Platonic solids, with one kind of face each. The cuboctahedron and the
      rhombicuboctahedron are Archimedean: two kinds of regular face, the same arrangement at every vertex. Left out are
      wall thickness and hollow forms, so the weight is that of a full block; real material tolerances, rounded edges
      and finish; and any solid beyond these seven. Density is a single number you supply.
    </p>
  </Fragment>
</Instrument>

<style>
  .readout-drawing {
    margin: 0;
  }
  .solid-drawing {
    max-width: 32rem;
  }
  /* The drawing is the handle: it takes the drag, so the page does not scroll under it. */
  .solid-drawing svg {
    cursor: grab;
    touch-action: none;
    user-select: none;
    -webkit-user-select: none;
  }
  .solid-drawing svg:active {
    cursor: grabbing;
  }
  .solid-drawing figcaption {
    max-width: 30em;
  }
  .solid-drawing :global(.sd-front),
  .solid-drawing :global(.sd-back),
  .solid-drawing :global(.sd-sphere),
  .solid-drawing :global(.sd-rule) {
    fill: none;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .solid-drawing :global(.sd-front) {
    stroke: var(--line);
    stroke-width: 1;
  }
  .solid-drawing :global(.sd-back) {
    stroke: var(--line-3);
    stroke-width: 0.6;
  }
  .solid-drawing :global(.sd-sphere) {
    stroke: var(--line-3);
    stroke-width: 0.6;
    stroke-dasharray: 0.1 4.4;
  }
  .solid-drawing :global(.sd-rule) {
    stroke: var(--line-2);
    stroke-width: 0.6;
  }
  .solid-drawing :global(.sd-node) {
    fill: var(--line);
  }
  .solid-drawing :global(.sd-near) {
    fill: var(--gold);
  }
  .solid-drawing :global(.sd-name) {
    font-family: var(--font-text);
    font-style: italic;
    font-size: 17px;
    fill: var(--line);
  }
  .solid-drawing :global(.sd-dim) {
    font-family: var(--font-mono);
    font-size: 10.5px;
    letter-spacing: 0.04em;
    fill: var(--line-2);
  }

  /* Seven names do not fit one row: a two-column grid, the longest name across both. */
  .solid-choice {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    border-right: 0;
    border-bottom: 0;
  }
  .solid-choice label {
    min-height: 44px;
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    border-left: 0;
    border-right: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
  }
  .solid-choice label:last-child {
    grid-column: 1 / -1;
  }
  .solid-choice label:has(input:focus-visible) {
    z-index: 1;
    outline-color: var(--gold);
  }

  .field-input input {
    min-height: 44px;
    font-family: var(--font-mono);
    letter-spacing: -0.02em;
  }
  .field-hint {
    font-size: var(--step-0);
    color: var(--line-2);
  }
  .action {
    min-height: 44px;
    color: var(--line);
  }
  .form-foot {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--s2);
  }
  .status {
    flex-basis: 100%;
    min-height: 1.6em;
    font-size: var(--step-0);
  }

  .figures {
    grid-template-columns: repeat(auto-fit, minmax(10rem, 1fr));
  }
  .figure dd {
    font-family: var(--font-mono);
    letter-spacing: -0.03em;
  }
  .figure.is-key dd {
    font-family: var(--font-mono);
    font-size: var(--step-4);
    letter-spacing: -0.04em;
  }
  .figure small {
    line-height: 1.35;
  }
  .ledger-wrap {
    overflow-x: auto;
  }
  .ledger th[scope='row'] {
    font-weight: 450;
    color: var(--line);
    border-bottom: 1px solid var(--rule);
    white-space: nowrap;
  }
  .ledger td {
    color: var(--line-2);
  }
  .ledger td.num {
    font-family: var(--font-mono);
    color: var(--line);
  }
  .ledger tr.is-total th,
  .ledger tr.is-total td {
    border-bottom: 1px solid var(--border-2);
    font-weight: 550;
  }
  .readout.is-stale .figures,
  .readout.is-stale .ledger {
    opacity: 0.45;
  }
</style>

<script>
  import {
    HOME,
    SOLID_DEFAULTS,
    SOLID_FIELDS,
    SOLID_KEYS,
    SOLID_QUERY,
    SOLIDS,
    compute,
    counts,
    describe,
    drawing,
    figures,
    parseSolid,
    validateField,
    type SolidInputs,
    type SolidKey,
  } from '../../lib/instruments/solid';

  const root = document.querySelector<HTMLElement>('[data-solid]');
  if (root) {
    const form = root.querySelector<HTMLFormElement>('form')!;
    const readout = root.querySelector<HTMLElement>('.readout')!;
    const svg = root.querySelector<SVGSVGElement>('[data-drawing]')!;
    const plot = root.querySelector<SVGGElement>('[data-plot]')!;
    const desc = root.querySelector<SVGDescElement>('#sd-svg-desc')!;
    const status = root.querySelector<HTMLElement>('[data-status]')!;
    const radios = [...root.querySelectorAll<HTMLInputElement>('input[name="solid"]')];
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)');

    const input = (k: SolidKey) => root.querySelector<HTMLInputElement>(`#sd-${k}`)!;

    const setError = (k: SolidKey, msg: string | null) => {
      const el = input(k);
      const err = root.querySelector<HTMLElement>(`#sd-${k}-err`);
      const wrap = el.closest('.field-input');
      if (msg) {
        el.setAttribute('aria-invalid', 'true');
        wrap?.setAttribute('aria-invalid', 'true');
        if (err) {
          err.textContent = msg;
          err.hidden = false;
        }
      } else {
        el.removeAttribute('aria-invalid');
        wrap?.removeAttribute('aria-invalid');
        if (err) {
          err.textContent = '';
          err.hidden = true;
        }
      }
    };

    const set = (el: Element | null | undefined, text: string) => {
      if (el && el.textContent !== text) el.textContent = text;
    };

    /* -------------------------------------------------------------- */
    /* The turn: drag, arrow keys, and a slow idle rotation            */

    let last = compute(SOLID_DEFAULTS);
    let yaw = HOME.yaw;
    let pitch = HOME.pitch;
    let vy = 0;
    let vp = 0;
    let dragging = false;
    let lastX = 0;
    let lastY = 0;
    let lastMove = 0;
    // The idle turn runs until the visitor takes hold of the solid.
    let idle = true;
    let visible = !('IntersectionObserver' in window);
    let raf = 0;
    let prev = 0;

    const draw = () => {
      plot.innerHTML = drawing(last, yaw, pitch);
    };

    const loop = (t: number) => {
      const dt = prev ? Math.min(0.05, (t - prev) / 1000) : 0.016;
      prev = t;
      const turning = idle && !reduce.matches;
      if (!dragging) {
        yaw += vy;
        pitch += vp;
        vy *= 0.94;
        vp *= 0.94;
        if (Math.abs(vy) < 1e-4) vy = 0;
        if (Math.abs(vp) < 1e-4) vp = 0;
        if (turning) yaw += 0.12 * dt;
      }
      pitch = Math.max(-1.5, Math.min(1.5, pitch));
      draw();
      const moving = dragging || vy !== 0 || vp !== 0 || turning;
      if (visible && moving) raf = requestAnimationFrame(loop);
      else {
        raf = 0;
        prev = 0;
      }
    };

    const kick = () => {
      if (!raf && visible) raf = requestAnimationFrame(loop);
    };

    svg.addEventListener('pointerdown', (e) => {
      if (e.button !== 0) return;
      dragging = true;
      idle = false;
      vy = 0;
      vp = 0;
      lastX = e.clientX;
      lastY = e.clientY;
      svg.setPointerCapture(e.pointerId);
      kick();
    });
    svg.addEventListener('pointermove', (e) => {
      if (!dragging) return;
      vy = (e.clientX - lastX) * 0.008;
      vp = -(e.clientY - lastY) * 0.008;
      lastX = e.clientX;
      lastY = e.clientY;
      lastMove = performance.now();
      yaw += vy;
      pitch += vp;
    });
    const release = () => {
      if (!dragging) return;
      dragging = false;
      // No coasting when the hand had already stopped, or when motion is reduced.
      if (reduce.matches || performance.now() - lastMove > 80) {
        vy = 0;
        vp = 0;
      }
    };
    svg.addEventListener('pointerup', release);
    svg.addEventListener('pointercancel', release);
    svg.addEventListener('lostpointercapture', release);

    svg.addEventListener('keydown', (e) => {
      const step = 0.14;
      if (e.key === 'ArrowLeft') yaw -= step;
      else if (e.key === 'ArrowRight') yaw += step;
      else if (e.key === 'ArrowUp') pitch += step;
      else if (e.key === 'ArrowDown') pitch -= step;
      else return;
      e.preventDefault();
      idle = false;
      vy = 0;
      vp = 0;
      pitch = Math.max(-1.5, Math.min(1.5, pitch));
      draw();
    });

    reduce.addEventListener('change', kick);

    if ('IntersectionObserver' in window) {
      new IntersectionObserver(
        (entries) => {
          visible = entries.some((en) => en.isIntersecting);
          if (visible) kick();
        },
        { rootMargin: '80px' },
      ).observe(svg);
    }

    /* -------------------------------------------------------------- */
    /* The measures                                                    */

    const chosen = () => parseSolid(radios.find((r) => r.checked)?.value ?? null) ?? SOLID_DEFAULTS.solid;

    const writeUrl = (vals: SolidInputs) => {
      const params = new URLSearchParams();
      if (vals.solid !== SOLID_DEFAULTS.solid) params.set(SOLID_QUERY, vals.solid);
      for (const k of SOLID_KEYS) {
        if (vals[k] !== SOLID_DEFAULTS[k]) params.set(SOLID_FIELDS[k].q, String(vals[k]));
      }
      const qs = params.toString();
      history.replaceState(null, '', qs ? `${location.pathname}?${qs}` : location.pathname);
    };

    let everValid = false;
    const update = (persist = true) => {
      const vals: SolidInputs = { ...SOLID_DEFAULTS, solid: chosen() };
      let bad = 0;
      for (const k of SOLID_KEYS) {
        const res = validateField(k, input(k).value);
        if ('error' in res) {
          setError(k, res.error);
          bad++;
        } else {
          setError(k, null);
          vals[k] = res.value;
        }
      }

      if (bad) {
        readout.classList.add('is-stale');
        // A shared link with a bad value never had a valid set of its own: say the readout is the defaults.
        const shown = everValid ? 'the last valid set' : 'the defaults';
        status.textContent = bad === 1 ? `One field needs a fix. The readout shows ${shown}.` : `${bad} fields need a fix. The readout shows ${shown}.`;
        return;
      }
      everValid = true;
      readout.classList.remove('is-stale');
      status.textContent = '';

      last = compute(vals);
      for (const f of figures(last)) {
        const el = readout.querySelector<HTMLElement>(`[data-fig="${f.id}"]`);
        set(el?.querySelector('dd'), f.value);
        set(el?.querySelector('small'), f.small);
      }
      for (const c of counts(last)) {
        const cells = readout.querySelectorAll<HTMLElement>(`[data-count="${c.id}"] td`);
        set(cells[0], c.detail);
        set(cells[1], c.value);
      }
      set(desc, describe(last));
      draw();
      if (persist) writeUrl(vals);
    };

    // Read a shared configuration from the query string.
    const params = new URLSearchParams(location.search);
    const wanted = params.get(SOLID_QUERY);
    const known = parseSolid(wanted);
    if (known) radios.forEach((r) => (r.checked = r.value === known));
    for (const k of SOLID_KEYS) {
      const v = params.get(SOLID_FIELDS[k].q);
      if (v !== null) input(k).value = v;
    }

    form.addEventListener('input', () => update());
    form.addEventListener('submit', (e) => e.preventDefault());

    root.querySelector('[data-copy]')!.addEventListener('click', async () => {
      if (readout.classList.contains('is-stale')) {
        status.textContent = 'Fix the marked field first. A link holds only a valid set.';
        return;
      }
      try {
        await navigator.clipboard.writeText(location.href);
        status.textContent = 'Link copied.';
      } catch {
        status.textContent = 'Copying is blocked here. Copy the address from the address bar.';
      }
    });

    root.querySelector('[data-reset]')!.addEventListener('click', () => {
      radios.forEach((r) => (r.checked = r.value === SOLID_DEFAULTS.solid));
      for (const k of SOLID_KEYS) input(k).value = SOLID_FIELDS[k].text;
      yaw = HOME.yaw;
      pitch = HOME.pitch;
      vy = 0;
      vp = 0;
      idle = true;
      update(false);
      history.replaceState(null, '', location.pathname);
      status.textContent = 'Back to the defaults.';
      kick();
    });

    update(false);
    if (wanted !== null && !known) {
      status.textContent = `This link names a solid the page does not have. The ${SOLIDS[SOLID_DEFAULTS.solid].label.toLowerCase()} is shown instead.`;
    }
  }
</script>
