---
import Instrument from '../../layouts/Instrument.astro';
import {
  BOTTLENECK_DEFAULTS,
  CAPACITY_MAX,
  PARTS,
  PLAN,
  VIEW,
  compute,
  describe,
  drawing,
  figures,
  ledger,
  reliefNote,
  scaleSpoken,
} from '../../lib/instruments/bottleneck';

const d = BOTTLENECK_DEFAULTS;
const result = compute(d);
const figs = figures(result);
const rows = ledger(result);
const bound = new Set(result.binding);
---

<Instrument
  title="Bottleneck"
  lede="A build-out delivers what its scarcest part allows. Find the stave that sets the level."
  description="Set the capacity of six parts of the AI compute chain and see which one binds, how much capacity sits idle behind it and how much capital is stranded."
  family="Code"
  slug="bottleneck"
>
  <div class="instrument-grid" data-bottleneck>
    <form class="controls" novalidate aria-label="Bottleneck assumptions">
      <fieldset class="group">
        <legend>Capacity, as an index</legend>
        <p class="group-note t-note">
          {PLAN} is the plan for each part. Below it the part is short, above it there is capacity to spare.
        </p>
        {
          PARTS.map((p) => (
            <label class="scale" data-part={p.key} data-binding={bound.has(p.key) ? '' : undefined}>
              <span class="field-label">
                <span class="part-name">
                  {p.label}
                  <span class="part-tag" data-tag aria-hidden="true" hidden={!bound.has(p.key)}>
                    Binding
                  </span>
                </span>
                <output class="scale-value" for={`bn-${p.key}`} id={`bn-${p.key}-out`}>
                  {d[p.key]}
                </output>
              </span>
              <input
                type="range"
                name={p.key}
                id={`bn-${p.key}`}
                min="0"
                max={CAPACITY_MAX}
                step="1"
                value={d[p.key]}
                aria-valuetext={scaleSpoken(result, p.key)}
              />
              <span class="scale-ticks" aria-hidden="true">
                <span>0</span>
                <span>{PLAN}</span>
                <span>{CAPACITY_MAX}</span>
              </span>
            </label>
          ))
        }
      </fieldset>

      <fieldset class="group">
        <legend>Capital</legend>
        <label class="field">
          <span class="field-label">Capital committed to the plan</span>
          <span class="field-input">
            <input
              type="text"
              inputmode="decimal"
              autocomplete="off"
              spellcheck="false"
              name="capital"
              id="bn-capital"
              value={String(d.capital)}
              aria-describedby="bn-capital-err bn-capital-note"
            />
            <span class="unit">US$ bn</span>
          </span>
          <span class="field-error" id="bn-capital-err" hidden></span>
        </label>
        <p class="group-note t-note" id="bn-capital-note">
          Spread equally across the six parts: each sixth pays for {PLAN} index points of its part.
        </p>
      </fieldset>

      <div class="form-foot">
        <button type="button" class="action" data-copy>Copy link</button>
        <button type="button" class="action" data-reset>Reset</button>
        <p class="t-note muted status" data-status aria-live="polite"></p>
      </div>
    </form>

    <div class="readout" aria-live="polite">
      <dl class="figures">
        {
          figs.map((f) => (
            <div class:list={['figure', { 'is-key': f.key }]} data-fig={f.id}>
              <dt>{f.label}</dt>
              <dd>{f.value}</dd>
              <small>{f.small}</small>
            </div>
          ))
        }
      </dl>

      <figure class="study readout-drawing" aria-live="off">
        <svg viewBox={`0 0 ${VIEW.w} ${VIEW.h}`} role="img" aria-labelledby="bn-svg-title bn-svg-desc" data-svg>
          <title id="bn-svg-title">Liebig's barrel: six staves of unequal height and the level they hold</title>
          <desc id="bn-svg-desc">{describe(result)}</desc>
          <defs>
            <pattern id="bn-water" width="16" height="8" patternUnits="userSpaceOnUse">
              <line x1="1" y1="2" x2="9" y2="2" style="stroke: var(--line-3); stroke-width: 0.7"></line>
              <line x1="9" y1="6" x2="15" y2="6" style="stroke: var(--line-3); stroke-width: 0.7"></line>
            </pattern>
            <pattern id="bn-surface" width="12" height="5" patternUnits="userSpaceOnUse">
              <line x1="0" y1="1.25" x2="7" y2="1.25" style="stroke: var(--line-2); stroke-width: 0.5"></line>
              <line x1="6" y1="3.75" x2="11" y2="3.75" style="stroke: var(--line-2); stroke-width: 0.5"></line>
            </pattern>
          </defs>
          <g data-plot set:html={drawing(result)} />
        </svg>
        <figcaption class="t-note">
          The liquid stands at the shortest stave and spills over it. The dashed ring is the plan.
        </figcaption>
      </figure>

      <div class="relief">
        <button type="button" class="action" data-relieve aria-describedby="bn-relief-note">Relieve the bottleneck</button>
        <p class="t-note relief-note" id="bn-relief-note" data-relief-note>{reliefNote(result)}</p>
      </div>

      <div class="ledger-wrap" aria-live="off">
        <table class="ledger">
          <caption class="visually-hidden">
            Each part of the chain: capacity, idle capacity, capital stranded in US$ billions, and the output added by one
            more unit of that part alone
          </caption>
          <thead>
            <tr>
              <th scope="col">Part</th>
              <th scope="col" class="num">Capacity</th>
              <th scope="col" class="num">Idle</th>
              <th scope="col" class="num">Stranded, US$bn</th>
              <th scope="col" class="num">One more unit adds</th>
            </tr>
          </thead>
          <tbody>
            {
              rows.map((row) => (
                <tr data-row={row.key} class:list={[{ 'is-total': row.key === 'total', 'is-binding': row.binding }]}>
                  <th scope="row">{row.label}</th>
                  <td class="num" data-cell="capacity">
                    {row.capacity}
                  </td>
                  <td class="num" data-cell="idle">
                    {row.idle}
                  </td>
                  <td class="num" data-cell="stranded">
                    {row.stranded}
                  </td>
                  <td class="num" data-cell="shadow">
                    {row.shadow}
                  </td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>

      <p class="note">
        Every figure on this page is illustrative. The six capacities are yours to set, not measurements of any company
        or market.
      </p>
    </div>
  </div>

  <Fragment slot="method">
    <p>
      The law of the minimum says that growth is set by the scarcest resource, not by the total of all resources. Carl
      Sprengel formulated it in 1828 for the nutrition of plants, and Justus von Liebig popularised it. The usual
      picture is a barrel whose staves are of unequal length, known as Liebig's barrel: it holds liquid only up to its
      shortest stave.
    </p>
    <p>
      Here each part of the chain has a capacity, as an index where 100 is the plan. The deliverable level is the
      minimum of the six, and the binding part is the one standing at that minimum. The next constraint is the lowest
      capacity above the level, and the headroom is the gap between the two: raising the binding part gains that much
      and no more, because the next part then binds. Idle capacity is a part's capacity minus the level.
    </p>
    <p>
      The shadow value follows directly. One more unit of the binding part adds one unit of output, and one more unit
      of any other part adds nothing. When several parts share the minimum, one more unit of any single one of them
      adds nothing either, so they have to rise together.
    </p>
    <p>
      Capital is committed to the plan and spread equally across the six parts, so each sixth pays for 100 index points
      of its part and nothing above. Every point of capital is then in one of three places: at work (the level, up to
      the plan), stranded (capacity that is built but stands above the level) or not built (the shortfall below the
      plan). The three add up to the capital committed. Capacity above the plan is idle in the table but carries none
      of this capital, which is why the stranded sum stops at the plan while the idle column does not.
    </p>
    <p>
      This is a good first model of a supply chain whose parts are complements. A chip without power, cooling, memory,
      packaging and networking computes nothing, and none of them stands in for another. In that case totals and
      averages mislead: the chain moves at the pace of its slowest part, and money spent anywhere else waits.
    </p>
    <p>
      The model deliberately leaves out five things. Substitution: parts can stand in for one another at the margin,
      for example a design that needs less power for the same compute. Lead times: they differ, so the part that binds
      today is not the part that binds in two years. Prices: the scarce part gets dearer and draws investment. Partial
      deliveries: capacity arrives in steps, not all at once. And real capacity is not a single number: it varies by
      place, by generation and by contract.
    </p>
    <p>The figures are illustrative. They are not data about any real company or market.</p>
    <p>
      <a href="/work/the-entity">THE ENTITY</a> maps this chain for real, with 835 companies on 80 nodes.
    </p>
  </Fragment>
</Instrument>

<style>
  .readout-drawing {
    margin: 0;
  }
  .readout-drawing svg {
    display: block;
    max-width: 30rem;
  }
  .readout-drawing figcaption {
    max-width: 34em;
  }
  .group-note {
    font-size: var(--step-0);
    color: var(--line-2);
    max-width: 30em;
  }
  .scale input[type='range'] {
    height: 44px;
  }
  .scale-value,
  .scale-ticks {
    font-family: var(--font-mono);
    font-stretch: normal;
  }
  .part-name {
    display: inline-flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.7em;
  }
  .part-tag {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--gold);
  }
  .part-tag[hidden] {
    display: none;
  }
  /* The binding scale carries the one accent: gold figure, gold index. */
  .scale[data-binding] .scale-value {
    color: var(--gold);
  }
  .scale[data-binding] input[type='range']::-webkit-slider-thumb {
    background: var(--gold);
  }
  .scale[data-binding] input[type='range']::-moz-range-thumb {
    background: var(--gold);
  }
  .action {
    min-height: 44px;
    color: var(--line);
    transition: background 200ms var(--ease-out);
  }
  .action[aria-disabled='true'] {
    color: var(--line-3);
    border-color: var(--line-3);
    cursor: default;
  }
  .action[aria-disabled='true']:hover {
    background: transparent;
  }
  .field-input input {
    min-height: 44px;
    font-family: var(--font-mono);
  }
  .field-error:not([hidden]) {
    display: block;
    padding-left: 0.6em;
    border-left: 1px solid var(--line);
    line-height: 1.4;
  }
  .form-foot {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--s2);
  }
  .status {
    font-size: var(--step-0);
  }
  .readout.is-stale .figures,
  .readout.is-stale .readout-drawing,
  .readout.is-stale .ledger-wrap {
    opacity: 0.45;
  }
  .figure dd {
    font-family: var(--font-mono);
  }
  .figure[data-fig='binding'] dd {
    font-family: var(--font-ui);
  }
  .figure.is-key dd {
    font-family: var(--font-mono);
    letter-spacing: -0.02em;
  }
  .figure small {
    line-height: 1.35;
  }
  .relief {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--s1) var(--s2);
    padding-top: var(--s2);
    border-top: 1px solid var(--rule);
  }
  .relief-note {
    flex: 1 1 14em;
    font-size: var(--step-0);
    color: var(--line-2);
  }
  .ledger-wrap {
    overflow-x: auto;
  }
  .ledger th[scope='row'] {
    font-weight: 450;
    color: var(--line);
    border-bottom: 1px solid var(--rule);
  }
  .ledger td.num {
    font-family: var(--font-mono);
  }
  .ledger tr.is-binding th,
  .ledger tr.is-binding td {
    color: var(--gold);
  }
  .ledger tr.is-total th {
    border-bottom: 1px solid var(--border-2);
    font-weight: 550;
  }

  /* The liquid runs over the binding stave; it stands still when motion is not wanted. */
  @media (prefers-reduced-motion: no-preference) {
    .readout-drawing :global(.bn-spill) {
      animation: bn-fall 1.1s linear infinite;
    }
  }
  @keyframes bn-fall {
    to {
      stroke-dashoffset: -11;
    }
  }
</style>

<script>
  import {
    BOTTLENECK_DEFAULTS,
    BOTTLENECK_FIELDS,
    BOTTLENECK_KEYS,
    PARTS,
    VIEW,
    VIEW_MIN_W,
    compute,
    describe,
    drawing,
    figures,
    ledger,
    relieve,
    reliefNote,
    scaleSpoken,
    validateField,
    type BottleneckInputs,
    type BottleneckKey,
    type BottleneckResult,
  } from '../../lib/instruments/bottleneck';

  const root = document.querySelector<HTMLElement>('[data-bottleneck]');
  if (root) {
    const form = root.querySelector<HTMLFormElement>('form')!;
    const readout = root.querySelector<HTMLElement>('.readout')!;
    const figure = root.querySelector<HTMLElement>('.readout-drawing')!;
    const svg = root.querySelector<SVGSVGElement>('[data-svg]')!;
    const plot = root.querySelector<SVGGElement>('[data-plot]')!;
    const desc = root.querySelector<SVGDescElement>('#bn-svg-desc')!;
    const status = root.querySelector<HTMLElement>('[data-status]')!;
    const relieveBtn = root.querySelector<HTMLButtonElement>('[data-relieve]')!;
    const relief = root.querySelector<HTMLElement>('[data-relief-note]')!;

    const input = (k: BottleneckKey) => root.querySelector<HTMLInputElement>(`#bn-${k}`)!;

    const set = (el: Element | null, text: string) => {
      if (el && el.textContent !== text) el.textContent = text;
    };

    const setError = (k: BottleneckKey, msg: string | null) => {
      const el = input(k);
      const err = root.querySelector<HTMLElement>(`#bn-${k}-err`);
      const wrap = el.closest('.field-input');
      if (msg) {
        el.setAttribute('aria-invalid', 'true');
        wrap?.setAttribute('aria-invalid', 'true');
        if (err) {
          err.textContent = msg;
          err.hidden = false;
        }
      } else {
        el.removeAttribute('aria-invalid');
        wrap?.removeAttribute('aria-invalid');
        if (err) {
          err.textContent = '';
          err.hidden = true;
        }
      }
    };

    const writeUrl = (vals: BottleneckInputs) => {
      const params = new URLSearchParams();
      for (const k of BOTTLENECK_KEYS) {
        if (vals[k] !== BOTTLENECK_DEFAULTS[k]) params.set(BOTTLENECK_FIELDS[k].q, String(vals[k]));
      }
      const qs = params.toString();
      history.replaceState(null, '', qs ? `${location.pathname}?${qs}` : location.pathname);
    };

    let last: BottleneckResult = compute(BOTTLENECK_DEFAULTS);

    // The barrel is lettered at true size: it is redrawn to the width it is shown at.
    const drawingWidth = () => {
      const w = Math.round(figure.getBoundingClientRect().width);
      return Math.max(VIEW_MIN_W, Math.min(VIEW.w, w || VIEW.w));
    };

    const draw = () => {
      const w = drawingWidth();
      svg.setAttribute('viewBox', `0 0 ${w} ${VIEW.h}`);
      plot.innerHTML = drawing(last, w);
    };

    let everValid = false;
    const update = (persist = true) => {
      const vals = {} as BottleneckInputs;
      let bad = 0;
      for (const k of BOTTLENECK_KEYS) {
        const res = validateField(k, input(k).value);
        if ('error' in res) {
          setError(k, res.error);
          bad++;
        } else {
          setError(k, null);
          vals[k] = res.value;
        }
      }
      // The scale lettering follows the thumb even while another field needs a fix.
      for (const p of PARTS) root.querySelector<HTMLOutputElement>(`#bn-${p.key}-out`)!.value = input(p.key).value;

      if (bad) {
        readout.classList.add('is-stale');
        // A shared link with a bad value never had a valid set of its own: say the readout is the defaults.
        const shown = everValid ? 'the last valid set' : 'the illustrative defaults';
        status.textContent = bad === 1 ? `One field needs a fix. The readout shows ${shown}.` : `${bad} fields need a fix. The readout shows ${shown}.`;
        return;
      }
      everValid = true;
      readout.classList.remove('is-stale');
      status.textContent = '';

      const r = compute(vals);
      last = r;
      for (const f of figures(r)) {
        const el = readout.querySelector<HTMLElement>(`[data-fig="${f.id}"]`);
        if (!el) continue;
        set(el.querySelector('dd'), f.value);
        set(el.querySelector('small'), f.small);
      }
      for (const row of ledger(r)) {
        const tr = readout.querySelector<HTMLElement>(`[data-row="${row.key}"]`);
        if (!tr) continue;
        tr.classList.toggle('is-binding', row.binding);
        set(tr.querySelector('[data-cell="capacity"]'), row.capacity);
        set(tr.querySelector('[data-cell="idle"]'), row.idle);
        set(tr.querySelector('[data-cell="stranded"]'), row.stranded);
        set(tr.querySelector('[data-cell="shadow"]'), row.shadow);
      }
      // Mark the binding scales and say so on each thumb.
      for (const p of r.parts) {
        const label = root.querySelector<HTMLElement>(`[data-part="${p.key}"]`)!;
        label.toggleAttribute('data-binding', p.binding);
        label.querySelector<HTMLElement>('[data-tag]')!.hidden = !p.binding;
        input(p.key).setAttribute('aria-valuetext', scaleSpoken(r, p.key));
      }
      set(relief, reliefNote(r));
      if (r.next) relieveBtn.removeAttribute('aria-disabled');
      else relieveBtn.setAttribute('aria-disabled', 'true');
      draw();
      desc.textContent = describe(r);
      if (persist) writeUrl(vals);
    };

    // Read a shared configuration from the query string.
    const params = new URLSearchParams(location.search);
    for (const k of BOTTLENECK_KEYS) {
      const v = params.get(BOTTLENECK_FIELDS[k].q);
      if (v !== null) input(k).value = v;
    }

    form.addEventListener('input', () => update());
    form.addEventListener('submit', (e) => e.preventDefault());

    // One step along the chain: the binding parts rise to the next constraint.
    relieveBtn.addEventListener('click', () => {
      const now = { ...last.inputs };
      for (const p of PARTS) now[p.key] = Number(input(p.key).value);
      const next = relieve(now);
      if (!next) return;
      for (const p of PARTS) input(p.key).value = String(next[p.key]);
      update();
    });

    root.querySelector('[data-copy]')!.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(location.href);
        status.textContent = 'Link copied. It opens this page with these settings.';
      } catch {
        status.textContent = 'Copying is blocked here. Copy the address from the address bar.';
      }
    });

    root.querySelector('[data-reset]')!.addEventListener('click', () => {
      for (const k of BOTTLENECK_KEYS) input(k).value = String(BOTTLENECK_DEFAULTS[k]);
      update(false);
      history.replaceState(null, '', location.pathname);
      status.textContent = 'Back to the illustrative defaults.';
    });

    update(false);

    if ('ResizeObserver' in window) {
      let lastW = drawingWidth();
      new ResizeObserver(() => {
        const w = drawingWidth();
        if (w !== lastW) {
          lastW = w;
          draw();
        }
      }).observe(figure);
    }
  }
</script>
