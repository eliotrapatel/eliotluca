---
import Base from '../layouts/Base.astro';
import Polyhedron from '../components/studies/Polyhedron.astro';
import Escapement from '../components/studies/Escapement.astro';
import LetterE from '../components/studies/LetterE.astro';
import AmmCurve from '../components/studies/AmmCurve.astro';
import ValueBridge from '../components/studies/ValueBridge.astro';
import Dieline from '../components/studies/Dieline.astro';
import Envelope from '../components/studies/Envelope.astro';
import Routing from '../components/studies/Routing.astro';
import EntityShowcase from '../components/ventures/EntityShowcase.astro';
import OrbesShowcase from '../components/ventures/OrbesShowcase.astro';
import Strata from '../components/Strata.astro';
import Lockup from '../components/brand/Lockup.astro';
import EssayList from '../components/EssayList.astro';
import Record from '../components/Record.astro';
import { site, disciplines } from '../data/site';
import { instruments } from '../data/instruments';
import { getEssays } from '../lib/writing';
import { layout, wordmarkSVG } from '../lib/wordmark';

// The name, word by word, with the hero's tracking (src/lib/logo-motion.ts decodes it).
const nameSVG = (w: string) => wordmarkSVG(layout(w, 0.1));

const essays = (await getEssays()).slice(0, 4);

const byStudy = Object.fromEntries(disciplines.map((d) => [d.study, d]));
const cells = [
  { id: 'polyhedron', C: Polyhedron, cls: 'c-poly', delay: 0 },
  { id: 'escapement', C: Escapement, cls: 'c-esc', delay: 200 },
  { id: 'letter', C: LetterE, cls: 'c-letter', delay: 320 },
  { id: 'bridge', C: ValueBridge, cls: 'c-bridge', delay: 440 },
  { id: 'amm', C: AmmCurve, cls: 'c-amm', delay: 560 },
  { id: 'envelope', C: Envelope, cls: 'c-env', delay: 680 },
  { id: 'dieline', C: Dieline, cls: 'c-die', delay: 800 },
  { id: 'routing', C: Routing, cls: 'c-route', delay: 920 },
];

const tools = instruments;

const roles = [
  { brand: 'entity', org: 'THE ENTITY', href: '/work/the-entity', role: 'Founder', what: 'AI supply-chain intelligence for investors' },
  { brand: 'orbes', org: 'ORBES', href: '/work/orbes', role: 'Founder', what: "Men's accessories, sold online worldwide" },
] as const;
---

<Base draw>
  <section class="hero wrap" aria-labelledby="name">
    <div class="head">
      <h1 id="name" class="name">
        <span class="visually-hidden">Eliot Luca</span>
        <span class="w" data-word="ELIOT" aria-hidden="true" set:html={nameSVG('ELIOT')} />
        <span class="w" data-word="LUCA" aria-hidden="true" set:html={nameSVG('LUCA')} />
      </h1>
      <p class="kicker t-label">Creator and operator</p>
      <p class="claim">I build on what is tangible.</p>
      <p class="intro">
        Eight disciplines, practised at once. I started with branding and design in 2016, crypto in 2017 and e-commerce
        in 2018. Finance came after, then music, AI, 3D modelling and watchmaking. All of it points at value you can
        trace to something real: the physical chains behind markets, and objects made to last.
      </p>

      <ul class="roles" aria-label="Ventures">
        {
          roles.map((r) => (
            <li>
              <a class="org" href={r.href} aria-label={r.org}>
                <Lockup brand={r.brand} />
              </a>
              <span class="role t-ui">{r.role}</span>
              <span class="what">{r.what}</span>
            </li>
          ))
        }
      </ul>

      <p class="actions">
        <a class="btn btn-primary" href={`mailto:${site.email}`}>Write to me</a>
        <a class="btn" href="/about">About me</a>
        {site.social.linkedin && <a class="btn" href={site.social.linkedin} rel="me noopener">LinkedIn</a>}
      </p>
    </div>

    <div class="studies">
      <div class="s s-poly"><Polyhedron delay={0} /></div>
      <div class="s s-letter"><LetterE delay={240} /></div>
      <div class="s s-esc"><Escapement delay={360} /></div>
      <div class="s s-env"><Envelope delay={480} /></div>
      <div class="s s-amm"><AmmCurve delay={600} /></div>
      <div class="s s-bridge"><ValueBridge delay={720} /></div>
      <div class="s s-die"><Dieline delay={840} /></div>
      <div class="s s-route"><Routing delay={960} /></div>
      <div class="s s-note">
        <p class="t-label">Studies</p>
        <p class="note-text">
          Eight disciplines, one drawing each, after Leonardo's notebooks. The solid turns under your hand; the
          escapement keeps time with this page.
        </p>
        <a class="note-link" href="/about#practice">Da Vinci Mode</a>
      </div>
    </div>
    <p class="swipe t-note" aria-hidden="true">Eight drawings, one per discipline. Swipe for the rest.</p>
  </section>

  <section class="wrap band" aria-labelledby="practice-title">
    <header class="band-head">
      <p class="t-label">Da Vinci Mode</p>
      <h2 id="practice-title" class="t-title band-title">Eight disciplines. <span class="t-fade">Practised at once, each feeding the others.</span></h2>
    </header>
    <div class="panel strata-panel">
      <Strata />
    </div>
  </section>

  <section class="wrap band" id="ventures" aria-labelledby="ventures-title">
    <header class="band-head">
      <p class="t-label">Ventures</p>
      <h2 id="ventures-title" class="t-title band-title">Two companies. <span class="t-fade">Both anchored in the physical world.</span></h2>
    </header>
    <div class="ventures">
      <div class="venture">
        <EntityShowcase />
        <p class="v-foot"><span class="v-role t-label">Founder</span><a href="/work/the-entity">More on THE ENTITY</a></p>
      </div>
      <div class="venture">
        <OrbesShowcase />
        <p class="v-foot"><span class="v-role t-label">Founder</span><a href="/work/orbes">More on ORBES</a></p>
      </div>
    </div>
  </section>

  <section class="wrap band" aria-labelledby="record-title">
    <header class="band-head">
      <p class="t-label">Record</p>
      <h2 id="record-title" class="t-title band-title">Then finance. <span class="t-fade">Private equity, venture capital, M&amp;A, from 2021.</span></h2>
    </header>
    <div class="panel record-panel">
      <Record />
    </div>
  </section>

  <section class="wrap band" aria-labelledby="tools-title">
    <header class="band-head">
      <p class="t-label">Instruments</p>
      <h2 id="tools-title" class="t-title band-title">Tools I built. <span class="t-fade">Open, in your browser.</span></h2>
    </header>
    <ul class="tools">
      {
        tools.map((t) => (
          <li>
            <a class="tool panel" href={`/instruments/${t.slug}`}>
              <span class="t-label">{t.family}</span>
              <span class="tool-value t-mono">{t.value}</span>
              <span class="tool-unit t-label">{t.unit}</span>
              <span class="tool-name">{t.name}</span>
              <span class="tool-line muted">{t.line}</span>
            </a>
          </li>
        ))
      }
    </ul>
  </section>

  {
    essays.length > 0 && (
      <section class="wrap band" aria-labelledby="writing-title">
        <header class="band-head">
          <p class="t-label">Writing</p>
          <h2 id="writing-title" class="t-title band-title">
            Essays. <span class="t-fade">On capital, technology and objects.</span>
          </h2>
        </header>
        <div class="panel essays-panel">
          <EssayList essays={essays} />
        </div>
      </section>
    )
  }
</Base>

<style>
  /* ---------- Hero ---------- */
  .hero {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    column-gap: clamp(12px, 2vw, 32px);
    align-items: center;
    padding-top: var(--s6);
    padding-bottom: var(--s5);
  }

  .head {
    grid-column: 1 / span 6;
  }

  /* The name is the logotype at display size, drawn as outlines so it can decode. */
  .name {
    display: flex;
    flex-wrap: nowrap;
    gap: 0 0.44em;
    padding-block: 0.16em;
    font-size: clamp(2.6rem, 0.5rem + 4.3vw, 4.75rem);
    line-height: 1;
    color: var(--line);
  }

  .name .w {
    display: block;
    flex: none;
  }

  .name .w :global(.wm) {
    display: block;
    height: 0.64em;
    overflow: visible;
    fill: currentColor;
  }

  .name :global(.scr) {
    fill: var(--gold);
  }

  :global(.logo-hold) .name .w {
    opacity: 0;
    animation: name-release 0s 2.4s forwards;
  }

  @keyframes name-release {
    to {
      opacity: 1;
    }
  }

  @media (max-width: 1100px) {
    .name {
      font-size: clamp(2.75rem, 0.5rem + 7.4vw, 5.25rem);
    }
  }

  .kicker {
    margin-top: var(--s4);
    color: var(--gold);
  }

  .claim {
    font-family: var(--font-title);
    margin-top: var(--s2);
    font-size: var(--step-3);
    line-height: 1.15;
    letter-spacing: -0.01em;
    max-width: 18em;
  }

  .intro {
    margin-top: var(--s2);
    font-size: var(--step-1);
    line-height: 1.5;
    max-width: 30em;
    color: var(--line-2);
  }

  .roles {
    list-style: none;
    margin-top: var(--s5);
    border-top: 1px solid var(--border-2);
    max-width: 48rem;
  }

  .roles li {
    display: grid;
    grid-template-columns: minmax(0, 1.45fr) minmax(0, 0.9fr) minmax(0, 1.45fr);
    gap: var(--s3);
    align-items: center;
    padding-block: 0.85rem;
    border-bottom: 1px solid var(--rule);
  }

  /* The two ventures, as their own logos. */
  .org {
    display: inline-flex;
    font-size: 0.875rem;
    text-decoration: none;
    transition: opacity 180ms var(--ease-out);
  }

  .org:hover {
    opacity: 0.8;
  }

  .org:hover {
    color: var(--gold);
  }

  .role {
    font-size: var(--step--1);
    color: var(--line-2);
  }

  .what {
    color: var(--line-2);
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: var(--s4);
  }

  .studies {
    display: contents;
  }

  .s {
    min-width: 0;
  }

  /* Desktop: the solid beside the introduction, smaller studies in its
     margin, the rest of the sheet below at varied sizes and heights. */
  .head {
    grid-row: 1 / span 2;
    align-self: start;
  }
  .s-poly {
    grid-column: 7 / span 3;
    grid-row: 1;
    align-self: start;
  }
  .s-letter {
    grid-column: 10 / span 3;
    grid-row: 1;
    align-self: start;
    margin-top: var(--s4);
  }
  .s-esc {
    grid-column: 7 / span 6;
    grid-row: 2;
    align-self: start;
    margin-top: var(--s4);
  }
  .s-env {
    grid-column: 1 / span 4;
    grid-row: 3;
    margin-top: var(--s7);
  }
  .s-amm {
    grid-column: 5 / span 4;
    grid-row: 3;
    margin-top: calc(var(--s7) + var(--s3));
    padding-inline: 4%;
  }
  .s-bridge {
    grid-column: 9 / span 4;
    grid-row: 3;
    margin-top: var(--s7);
  }
  .s-die {
    grid-column: 1 / span 4;
    grid-row: 4;
    margin-top: var(--s6);
  }
  .s-route {
    grid-column: 5 / span 4;
    grid-row: 4;
    margin-top: var(--s5);
    padding-inline: 8%;
  }
  .s-note {
    grid-column: 9 / span 4;
    grid-row: 4;
    align-self: end;
    margin-bottom: var(--s5);
    padding-left: var(--s3);
    border-left: 1px solid var(--border-2);
  }
  .note-text {
    margin-top: var(--s2);
    color: var(--line-2);
    max-width: 24em;
  }
  .note-link {
    display: inline-block;
    margin-top: var(--s2);
    font-size: var(--step--1);
    color: var(--line);
  }

  .swipe {
    display: none;
    color: var(--line-2);
  }

  @media (max-width: 1100px) {
    .head {
      grid-column: 1 / -1;
      grid-row: 1;
    }
    .s-poly {
      grid-column: 1 / span 6;
      grid-row: 2;
      margin-top: var(--s6);
    }
    .s-letter {
      grid-column: 8 / span 5;
      grid-row: 2;
      margin-top: var(--s6);
    }
    .s-esc {
      grid-column: 1 / span 6;
      grid-row: 3;
    }
    .s-env {
      grid-column: 7 / span 6;
      grid-row: 3;
      margin-top: var(--s5);
    }
    .s-amm {
      grid-column: 1 / span 6;
      grid-row: 4;
    }
    .s-bridge {
      grid-column: 7 / span 6;
      grid-row: 4;
      margin-top: var(--s6);
    }
    .s-die {
      grid-column: 1 / span 6;
      grid-row: 5;
    }
    .s-route {
      grid-column: 7 / span 6;
      grid-row: 5;
      margin-top: var(--s5);
      padding-inline: 0;
    }
    .s-amm {
      padding-inline: 0;
    }
    .s-note {
      grid-column: 1 / span 8;
      grid-row: 6;
      margin: var(--s6) 0 0;
    }
  }

  /* Phones: words first, then the sheet as a strip, two drawings at a time. */
  @media (max-width: 700px) {
    .hero {
      display: block;
      padding-top: var(--s4);
    }
    .name {
      flex-direction: column;
      gap: 0.3em;
      font-size: 18.5vw;
    }
    .roles li {
      grid-template-columns: 1fr auto;
      row-gap: 0.15rem;
    }
    .what {
      grid-column: 1 / -1;
      font-size: var(--step--1);
    }
    .studies {
      display: flex;
      gap: var(--s3);
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      margin: var(--s5) calc(-1 * var(--gutter)) 0;
      padding: 0 var(--gutter) var(--s2);
      scroll-padding-inline: var(--gutter);
      scrollbar-width: none;
      align-items: flex-end;
    }
    .studies::-webkit-scrollbar {
      display: none;
    }
    .s {
      flex: 0 0 calc((100vw - 2 * var(--gutter) - var(--s3)) / 2);
      scroll-snap-align: start;
      margin: 0 !important;
    }
    .s :global(figcaption .meta) {
      display: none;
    }
    .s :global(figcaption .t-note) {
      font-size: var(--step--1);
    }
    .s-note {
      display: none;
    }
    .swipe {
      display: block;
      font-size: var(--step--1);
      margin-top: var(--s1);
    }
  }

  .strata-panel {
    padding: clamp(18px, 3vw, 32px);
  }

  .band {
    margin-top: var(--s8);
  }

  .band-head {
    margin-bottom: var(--s5);
  }

  .band-title {
    margin-top: var(--s2);
    font-size: var(--step-5);
    max-width: 18em;
  }

  .ventures {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 24px;
    align-items: stretch;
  }

  .venture {
    display: flex;
    flex-direction: column;
  }

  .venture > :global(article) {
    flex: 1;
  }


  .venture > :global(.plate) {
    transition: transform 400ms var(--ease-out);
  }

  .venture:hover > :global(.plate) {
    transform: translateY(-4px);
  }

  .v-foot {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--s3);
    margin-top: 16px;
    padding: 0 4px;
    font-size: var(--step--1);
  }

  .v-foot a {
    color: var(--line);
    text-decoration-color: var(--border-2);
  }

  .v-foot a:hover {
    text-decoration-color: var(--gold);
  }

  .v-role {
    padding: 5px 10px;
    border: 1px solid var(--border);
    border-radius: 999px;
    white-space: nowrap;
  }

  @media (max-width: 900px) {
    .ventures {
      grid-template-columns: 1fr;
    }
  }

  .record-panel,
  .essays-panel {
    padding: clamp(18px, 3vw, 32px);
  }

  /* Inside a panel the panel edge is the rule: drop the list's own top line. */
  .record-panel :global(.ledger-table),
  .essays-panel :global(.essays) {
    border-top: 0;
  }

  .tools {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 16px;
  }

  .tool {
    display: grid;
    gap: 6px;
    height: 100%;
    padding: 22px 22px 24px;
    text-decoration: none;
    transition:
      border-color 250ms var(--ease-out),
      transform 250ms var(--ease-out);
  }

  .tool:hover {
    border-color: rgb(205 182 138 / 0.35);
    transform: translateY(-3px);
  }

  .tool-value {
    margin-top: var(--s4);
    font-size: var(--step-3);
    white-space: nowrap;
    letter-spacing: -0.03em;
    color: var(--line);
  }

  .tool-unit {
    letter-spacing: 0.12em;
  }

  .tool-name {
    margin-top: var(--s3);
    font-weight: 500;
    font-size: var(--step-1);
  }

  .tool-line {
    font-size: var(--step--1);
  }

  .tools-more {
    margin-top: var(--s3);
    font-size: var(--step--1);
  }

  @media (max-width: 1000px) {
    .tools {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 560px) {
    .tools {
      grid-template-columns: 1fr;
    }
  }
</style>

<script>
  import { NameLoop } from '../lib/logo-motion';

  // The name composes, holds a second, comes apart, again.
  const words = [...document.querySelectorAll<HTMLElement>('.name .w')];
  if (words.length) {
    const name = new NameLoop(words, 0.1);
    const intro = document.documentElement.dataset.intro === '1';
    name.loop({ intro });
    document.addEventListener('visibilitychange', () => {
      if (document.hidden) {
        name.stop();
        name.rest();
      } else name.loop();
    });
  }
</script>

<script>
  // Hovering a discipline in the timeline lights its drawing, and the other way round.
  const figs = new Map<string, HTMLElement>();
  document.querySelectorAll<HTMLElement>('figure.study[data-study]').forEach((f) => figs.set(f.dataset.study!, f));
  document.querySelectorAll<HTMLElement>('.strata .row[data-study]').forEach((row) => {
    const fig = figs.get(row.dataset.study!);
    if (!fig) return;
    const on = () => (row.classList.add('is-lit'), fig.classList.add('is-lit'));
    const off = () => (row.classList.remove('is-lit'), fig.classList.remove('is-lit'));
    for (const el of [row, fig]) {
      el.addEventListener('pointerenter', on);
      el.addEventListener('pointerleave', off);
      el.addEventListener('focusin', on);
      el.addEventListener('focusout', off);
    }
  });
</script>
