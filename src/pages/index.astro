---
import Base from '../layouts/Base.astro';
import Polyhedron from '../components/studies/Polyhedron.astro';
import Escapement from '../components/studies/Escapement.astro';
import LetterE from '../components/studies/LetterE.astro';
import AmmCurve from '../components/studies/AmmCurve.astro';
import ValueBridge from '../components/studies/ValueBridge.astro';
import Dieline from '../components/studies/Dieline.astro';
import Envelope from '../components/studies/Envelope.astro';
import Routing from '../components/studies/Routing.astro';
import EntityPlate from '../components/plates/EntityPlate.astro';
import OrbesPlate from '../components/plates/OrbesPlate.astro';
import Strata from '../components/Strata.astro';
import EssayList from '../components/EssayList.astro';
import Record from '../components/Record.astro';
import { site, disciplines } from '../data/site';
import { getEssays } from '../lib/writing';
import { getCollection } from 'astro:content';

const essays = (await getEssays()).slice(0, 4);
const lab = (await getCollection('work', ({ data }) => data.visible && data.tier === 'lab')).sort(
  (a, b) => a.data.order - b.data.order,
);

const byStudy = Object.fromEntries(disciplines.map((d) => [d.study, d]));
const cells = [
  { id: 'polyhedron', C: Polyhedron, cls: 'c-poly', delay: 0 },
  { id: 'escapement', C: Escapement, cls: 'c-esc', delay: 200 },
  { id: 'letter', C: LetterE, cls: 'c-letter', delay: 320 },
  { id: 'bridge', C: ValueBridge, cls: 'c-bridge', delay: 440 },
  { id: 'amm', C: AmmCurve, cls: 'c-amm', delay: 560 },
  { id: 'envelope', C: Envelope, cls: 'c-env', delay: 680 },
  { id: 'dieline', C: Dieline, cls: 'c-die', delay: 800 },
  { id: 'routing', C: Routing, cls: 'c-route', delay: 920 },
];

const credentials = ['Amundi Technology', 'Novastone Capital Advisors', 'ESSEC Business School', 'emlyon business school', 'McGill University'];

const tools = [
  { slug: 'returns', family: 'Capital', name: 'Returns', line: 'What a buyout returns, and where the return comes from.', value: '2.86×', unit: 'MOIC, 23.4% IRR' },
  { slug: 'dilution', family: 'Capital', name: 'Dilution', line: 'What founders keep, round after round, pool included.', value: '52.1%', unit: 'founders after Series A' },
  { slug: 'copilot-economics', family: 'Code', name: 'Copilot economics', line: 'What an AI copilot costs per user, and the margin left.', value: '80.4%', unit: 'gross margin' },
  { slug: 'ring-sizes', family: 'Craft', name: 'Ring sizes', line: 'One finger, six sizing systems, in millimetres.', value: '17.0 mm', unit: 'US 6½, UK M½, EU 53' },
];

const roles = [
  { org: 'THE ENTITY', href: '/work/the-entity', role: 'Founder', what: 'AI supply-chain intelligence for investors' },
  { org: 'ORBES', href: '/work/orbes', role: 'Founder', what: 'Jewellery house, Paris' },
  { org: 'Amundi Technology', href: '/about#record', role: 'Corporate development', what: 'Strategy and transformation, post-merger integration' },
  { org: 'Novastone Capital Advisors', href: '/about#record', role: 'Analyst', what: 'Private equity and search fund' },
];
---

<Base draw>
  <section class="hero wrap" aria-labelledby="name">
    <div class="head">
      <h1 id="name" class="t-title name">Eliot Luca</h1>
      <p class="claim">I build on what is tangible.</p>
      <p class="intro">
        Trained in private equity, venture capital and M&amp;A. THE ENTITY ties markets to the physical value chain behind
        AI: power, chips, facilities. ORBES makes jewellery in gold and stone, meant to last. Same mindset: value you can
        trace to something real.
      </p>

      <ul class="roles" aria-label="Current and past roles">
        {
          roles.map((r) => (
            <li>
              <a class="org" href={r.href}>
                {r.org}
              </a>
              <span class="role t-ui">{r.role}</span>
              <span class="what">{r.what}</span>
            </li>
          ))
        }
      </ul>

      <p class="actions t-ui">
        <a href={`mailto:${site.email}`}>Write to me</a>
        <a href="/about">About</a>
        {site.social.linkedin && <a href={site.social.linkedin} rel="me noopener">LinkedIn</a>}
      </p>
    </div>

    <div class="studies">
      <div class="s s-poly"><Polyhedron delay={0} /></div>
      <div class="s s-letter"><LetterE delay={240} /></div>
      <div class="s s-esc"><Escapement delay={360} /></div>
      <div class="s s-env"><Envelope delay={480} /></div>
      <div class="s s-amm"><AmmCurve delay={600} /></div>
      <div class="s s-bridge"><ValueBridge delay={720} /></div>
      <div class="s s-die"><Dieline delay={840} /></div>
      <div class="s s-route"><Routing delay={960} /></div>
    </div>
    <p class="swipe t-note" aria-hidden="true">Eight drawings, one per discipline. Swipe for the rest.</p>
  </section>

  <section class="wrap band" aria-labelledby="practice-title">
    <header class="band-head">
      <p class="t-label">Disciplines</p>
      <h2 id="practice-title" class="t-title band-title">Eight fields. <span class="t-fade">Each started on a known date.</span></h2>
    </header>
    <div class="panel strata-panel">
      <Strata />
    </div>
  </section>

  <section class="wrap creds" aria-labelledby="creds-title">
    <h2 id="creds-title" class="t-label creds-title">Trained and tested at</h2>
    <ul class="creds-list">
      {credentials.map((c) => <li>{c}</li>)}
    </ul>
  </section>

  <section class="wrap band" id="ventures" aria-labelledby="ventures-title">
    <header class="band-head">
      <p class="t-label">Ventures</p>
      <h2 id="ventures-title" class="t-title band-title">Two companies. <span class="t-fade">Both anchored in the physical world.</span></h2>
    </header>
    <div class="ventures">
      <div class="venture">
        <EntityPlate size="feature" />
        <div class="v-meta">
          <div>
            <h3 class="v-name"><a href="/work/the-entity">THE ENTITY</a></h3>
            <p class="muted">The institutional-grade map of the AI supply chain. Live, model 2.8.</p>
          </div>
          <span class="v-role t-label">Founder</span>
        </div>
      </div>
      <div class="venture">
        <OrbesPlate size="feature" />
        <div class="v-meta">
          <div>
            <h3 class="v-name"><a href="/work/orbes">ORBES</a></h3>
            <p class="muted">A Paris jewellery house. Few pieces, by draw, each with a code you can verify.</p>
          </div>
          <span class="v-role t-label">Founder</span>
        </div>
      </div>
    </div>
    {
      lab.length > 0 && (
        <ul class="lab">
          {lab.map((w) => (
            <li>
              <a href={`/work/${w.id}`} class="lab-link">
                <span class="lab-name">{w.data.name}</span>
                <span class="lab-line muted">{w.data.line}</span>
                <span class="t-label">{w.data.status}</span>
              </a>
            </li>
          ))}
        </ul>
      )
    }
  </section>

  <section class="wrap band" aria-labelledby="record-title">
    <header class="band-head">
      <p class="t-label">Record</p>
      <h2 id="record-title" class="t-title band-title">Finance first. <span class="t-fade">Private equity, venture capital, M&amp;A.</span></h2>
    </header>
    <div class="panel record-panel">
      <Record />
    </div>
  </section>

  <section class="wrap band" aria-labelledby="tools-title">
    <header class="band-head">
      <p class="t-label">Instruments</p>
      <h2 id="tools-title" class="t-title band-title">Tools I use. <span class="t-fade">Open, in your browser.</span></h2>
    </header>
    <ul class="tools">
      {
        tools.map((t) => (
          <li>
            <a class="tool panel" href={`/instruments/${t.slug}`}>
              <span class="t-label">{t.family}</span>
              <span class="tool-value t-mono">{t.value}</span>
              <span class="tool-unit t-label">{t.unit}</span>
              <span class="tool-name">{t.name}</span>
              <span class="tool-line muted">{t.line}</span>
            </a>
          </li>
        ))
      }
    </ul>
  </section>

  {
    essays.length > 0 && (
      <section class="wrap band" aria-labelledby="writing-title">
        <header class="band-head">
          <p class="t-label">Writing</p>
          <h2 id="writing-title" class="t-title band-title">
            Essays. <span class="t-fade">On capital, technology and objects.</span>
          </h2>
        </header>
        <div class="panel essays-panel">
          <EssayList essays={essays} />
        </div>
      </section>
    )
  }
</Base>

<style>
  /* ---------- Hero ---------- */
  .hero {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    column-gap: clamp(12px, 2vw, 32px);
    align-items: center;
    padding-top: var(--s6);
    padding-bottom: var(--s5);
  }

  .head {
    grid-column: 1 / span 6;
  }

  .name {
    font-size: clamp(3rem, 1rem + 6vw, 5.5rem);
    line-height: 0.95;
    letter-spacing: 0.02em;
    white-space: nowrap;
  }

  .claim {
    font-family: var(--font-title);
    margin-top: var(--s4);
    font-size: var(--step-3);
    line-height: 1.15;
    letter-spacing: -0.01em;
    max-width: 18em;
  }

  .intro {
    margin-top: var(--s2);
    font-size: var(--step-1);
    line-height: 1.5;
    max-width: 30em;
    color: var(--line-2);
  }

  .roles {
    list-style: none;
    margin-top: var(--s5);
    border-top: 1px solid var(--line);
    max-width: 48rem;
  }

  .roles li {
    display: grid;
    grid-template-columns: minmax(0, 1.45fr) minmax(0, 0.9fr) minmax(0, 1.45fr);
    gap: var(--s3);
    align-items: baseline;
    padding-block: 0.7rem;
    border-bottom: 1px solid var(--rule);
  }

  .org {
    font-size: var(--step-0);
    font-weight: 500;
    text-decoration: none;
  }

  .org:hover {
    color: var(--gold);
  }

  .role {
    font-size: var(--step--1);
    color: var(--line-2);
  }

  .what {
    color: var(--line-2);
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s1) var(--s4);
    margin-top: var(--s4);
    font-size: var(--step--1);
    font-weight: 500;
  }

  .actions a {
    text-decoration-color: var(--line);
    padding-block: 0.6rem;
  }

  .studies {
    display: contents;
  }

  .s {
    min-width: 0;
  }

  /* Desktop: the solid beside the introduction, smaller studies in its
     margin, the rest of the sheet below at varied sizes and heights. */
  .head {
    grid-row: 1 / span 2;
    align-self: start;
  }
  .s-poly {
    grid-column: 7 / span 3;
    grid-row: 1;
    align-self: start;
  }
  .s-letter {
    grid-column: 10 / span 3;
    grid-row: 1;
    align-self: start;
    margin-top: var(--s4);
  }
  .s-esc {
    grid-column: 7 / span 6;
    grid-row: 2;
    align-self: start;
    margin-top: var(--s4);
  }
  .s-env {
    grid-column: 1 / span 4;
    grid-row: 3;
    margin-top: var(--s7);
  }
  .s-amm {
    grid-column: 5 / span 3;
    grid-row: 3;
    margin-top: var(--s8);
  }
  .s-bridge {
    grid-column: 9 / span 3;
    grid-row: 3;
    margin-top: var(--s6);
  }
  .s-die {
    grid-column: 2 / span 3;
    grid-row: 4;
    margin-top: var(--s5);
  }
  .s-route {
    grid-column: 8 / span 3;
    grid-row: 4;
    margin-top: var(--s4);
  }

  .swipe {
    display: none;
    color: var(--line-2);
  }

  @media (max-width: 1100px) {
    .head {
      grid-column: 1 / -1;
      grid-row: 1;
    }
    .s-poly {
      grid-column: 1 / span 6;
      grid-row: 2;
      margin-top: var(--s6);
    }
    .s-letter {
      grid-column: 8 / span 5;
      grid-row: 2;
      margin-top: var(--s6);
    }
    .s-esc {
      grid-column: 1 / span 6;
      grid-row: 3;
    }
    .s-env {
      grid-column: 7 / span 6;
      grid-row: 3;
      margin-top: var(--s5);
    }
    .s-amm {
      grid-column: 1 / span 6;
      grid-row: 4;
    }
    .s-bridge {
      grid-column: 7 / span 6;
      grid-row: 4;
      margin-top: var(--s6);
    }
    .s-die {
      grid-column: 1 / span 6;
      grid-row: 5;
    }
    .s-route {
      grid-column: 7 / span 6;
      grid-row: 5;
      margin-top: var(--s5);
    }
  }

  /* Phones: words first, then the sheet as a strip, two drawings at a time. */
  @media (max-width: 700px) {
    .hero {
      display: block;
      padding-top: var(--s4);
    }
    .name {
      font-size: 16vw;
    }
    .roles li {
      grid-template-columns: 1fr auto;
      row-gap: 0.15rem;
    }
    .what {
      grid-column: 1 / -1;
      font-size: var(--step--1);
    }
    .studies {
      display: flex;
      gap: var(--s3);
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      margin: var(--s5) calc(-1 * var(--gutter)) 0;
      padding: 0 var(--gutter) var(--s2);
      scroll-padding-inline: var(--gutter);
      scrollbar-width: none;
      align-items: flex-end;
    }
    .studies::-webkit-scrollbar {
      display: none;
    }
    .s {
      flex: 0 0 calc((100vw - 2 * var(--gutter) - var(--s3)) / 2);
      scroll-snap-align: start;
      margin: 0 !important;
    }
    .s :global(figcaption .meta) {
      display: none;
    }
    .s :global(figcaption .t-note) {
      font-size: var(--step--1);
    }
    .swipe {
      display: block;
      font-size: var(--step--1);
      margin-top: var(--s1);
    }
  }

  .strata-panel {
    padding: clamp(18px, 3vw, 32px);
  }

  .creds {
    margin-top: var(--s7);
    text-align: center;
  }

  .creds-title {
    font-weight: 400;
  }

  .creds-list {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 14px clamp(24px, 4vw, 56px);
    margin-top: var(--s3);
    font-size: var(--step-1);
    font-weight: 500;
    letter-spacing: -0.01em;
    color: var(--line-2);
  }

  .band {
    margin-top: var(--s8);
  }

  .band-head {
    margin-bottom: var(--s5);
  }

  .band-title {
    margin-top: var(--s2);
    font-size: var(--step-5);
    max-width: 18em;
  }

  .ventures {
    display: grid;
    grid-template-columns: 7fr 5fr;
    gap: 20px;
    align-items: start;
  }

  .venture {
    display: grid;
    gap: 18px;
    text-decoration: none;
    color: inherit;
  }

  .venture > :global(*:first-child) {
    transition: transform 400ms var(--ease-out);
  }

  .venture:hover > :global(*:first-child) {
    transform: translateY(-4px);
  }

  .v-meta {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: var(--s3);
    padding: 0 4px;
  }

  .v-name {
    font-size: var(--step-2);
    letter-spacing: -0.02em;
  }

  .v-name a {
    text-decoration: none;
  }

  .v-name a:hover {
    color: var(--gold);
  }

  .v-meta p {
    margin-top: 4px;
    max-width: 30em;
  }

  .v-role {
    padding: 5px 10px;
    border: 1px solid var(--border);
    border-radius: 999px;
    white-space: nowrap;
  }

  @media (max-width: 900px) {
    .ventures {
      grid-template-columns: 1fr;
    }
  }

  .lab {
    list-style: none;
    margin-top: 28px;
    border-top: 1px solid var(--border);
  }

  .lab-link {
    display: grid;
    grid-template-columns: 10rem minmax(0, 1fr) auto;
    gap: var(--s3);
    align-items: baseline;
    padding: 18px 4px;
    border-bottom: 1px solid var(--border);
    text-decoration: none;
  }

  .lab-link:hover .lab-name {
    color: var(--gold);
  }

  .lab-name {
    font-weight: 500;
    transition: color 180ms;
  }

  @media (max-width: 700px) {
    .lab-link {
      grid-template-columns: 1fr auto;
    }
    .lab-line {
      grid-column: 1 / -1;
      grid-row: 2;
    }
  }

  .record-panel,
  .essays-panel {
    padding: clamp(18px, 3vw, 32px);
  }

  .tools {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 16px;
  }

  .tool {
    display: grid;
    gap: 6px;
    height: 100%;
    padding: 22px 22px 24px;
    text-decoration: none;
    transition:
      border-color 250ms var(--ease-out),
      transform 250ms var(--ease-out);
  }

  .tool:hover {
    border-color: rgb(205 182 138 / 0.35);
    transform: translateY(-3px);
  }

  .tool-value {
    margin-top: var(--s4);
    font-size: var(--step-4);
    letter-spacing: -0.03em;
    color: var(--line);
  }

  .tool-unit {
    letter-spacing: 0.12em;
  }

  .tool-name {
    margin-top: var(--s3);
    font-weight: 500;
    font-size: var(--step-1);
  }

  .tool-line {
    font-size: var(--step--1);
  }

  @media (max-width: 1000px) {
    .tools {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 560px) {
    .tools {
      grid-template-columns: 1fr;
    }
  }
</style>

<script>
  // Hovering a discipline in the timeline lights its drawing, and the other way round.
  const figs = new Map<string, HTMLElement>();
  document.querySelectorAll<HTMLElement>('figure.study[data-study]').forEach((f) => figs.set(f.dataset.study!, f));
  document.querySelectorAll<HTMLElement>('.strata .row[data-study]').forEach((row) => {
    const fig = figs.get(row.dataset.study!);
    if (!fig) return;
    const on = () => (row.classList.add('is-lit'), fig.classList.add('is-lit'));
    const off = () => (row.classList.remove('is-lit'), fig.classList.remove('is-lit'));
    for (const el of [row, fig]) {
      el.addEventListener('pointerenter', on);
      el.addEventListener('pointerleave', off);
      el.addEventListener('focusin', on);
      el.addEventListener('focusout', off);
    }
  });
</script>
