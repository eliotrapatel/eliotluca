---
import Base from '../layouts/Base.astro';
import Polyhedron from '../components/studies/Polyhedron.astro';
import Escapement from '../components/studies/Escapement.astro';
import LetterE from '../components/studies/LetterE.astro';
import AmmCurve from '../components/studies/AmmCurve.astro';
import ValueBridge from '../components/studies/ValueBridge.astro';
import Dieline from '../components/studies/Dieline.astro';
import Envelope from '../components/studies/Envelope.astro';
import Routing from '../components/studies/Routing.astro';
import EntityPlate from '../components/plates/EntityPlate.astro';
import OrbesPlate from '../components/plates/OrbesPlate.astro';
import Strata from '../components/Strata.astro';
import EssayList from '../components/EssayList.astro';
import InstrumentList from '../components/InstrumentList.astro';
import { site } from '../data/site';
import { getEssays } from '../lib/writing';
import { getCollection } from 'astro:content';

const essays = (await getEssays()).slice(0, 4);
const lab = (await getCollection('work', ({ data }) => data.visible && data.tier === 'lab')).sort(
  (a, b) => a.data.order - b.data.order,
);

const roles = [
  { org: 'THE ENTITY', href: '/work/the-entity', role: 'Founder', what: 'AI supply-chain intelligence for investors' },
  { org: 'ORBES', href: '/work/orbes', role: 'Founder', what: 'Jewellery house, Paris' },
  { org: 'Amundi Technology', href: '/about#record', role: 'Corporate development', what: 'Strategy and transformation, post-merger integration' },
  { org: 'Novastone Capital Advisors', href: '/about#record', role: 'Analyst', what: 'Private equity and search fund' },
];
---

<Base draw>
  <section class="hero wrap" aria-labelledby="name">
    <div class="head">
      <h1 id="name" class="t-title name">Eliot Luca</h1>
      <p class="claim">I work where capital, software and objects meet.</p>
      <p class="intro">
        Trained in private equity, venture capital and M&amp;A. I now build two companies: an intelligence platform for
        investors and a jewellery house.
      </p>

      <ul class="roles" aria-label="Current and past roles">
        {
          roles.map((r) => (
            <li>
              <a class="org" href={r.href}>
                {r.org}
              </a>
              <span class="role t-ui">{r.role}</span>
              <span class="what">{r.what}</span>
            </li>
          ))
        }
      </ul>

      <p class="actions t-ui">
        <a href={`mailto:${site.email}`}>Write to me</a>
        <a href="/about">About</a>
        {site.social.linkedin && <a href={site.social.linkedin} rel="me noopener">LinkedIn</a>}
      </p>
    </div>

    <div class="studies">
      <div class="s s-poly"><Polyhedron delay={0} /></div>
      <div class="s s-letter"><LetterE delay={240} /></div>
      <div class="s s-esc"><Escapement delay={360} /></div>
      <div class="s s-env"><Envelope delay={480} /></div>
      <div class="s s-amm"><AmmCurve delay={600} /></div>
      <div class="s s-bridge"><ValueBridge delay={720} /></div>
      <div class="s s-die"><Dieline delay={840} /></div>
      <div class="s s-route"><Routing delay={960} /></div>
    </div>
    <p class="swipe t-note" aria-hidden="true">Eight drawings, one per discipline. Swipe for the rest.</p>
  </section>

  <section class="band wrap" aria-labelledby="ventures-title">
    <header class="band-head">
      <h2 id="ventures-title" class="band-title">Ventures</h2>
      <p class="band-more t-ui"><a href="/work">All ventures</a></p>
    </header>
    <div class="plates">
      <article class="plate-fig plate-entity">
        <EntityPlate size="feature" />
        <div class="plate-cap">
          <h3><a href="/work/the-entity">THE ENTITY</a></h3>
          <p>The institutional-grade map of the AI supply chain, built for investors. Live, model 2.8.</p>
        </div>
      </article>
      <article class="plate-fig plate-orbes">
        <OrbesPlate size="feature" />
        <div class="plate-cap">
          <h3><a href="/work/orbes">ORBES</a></h3>
          <p>A Paris jewellery house. Few pieces, allocated by draw, each with a code you can verify.</p>
        </div>
      </article>
    </div>
    {
      lab.length > 0 && (
        <div class="lab">
          <h3 class="lab-title">Also in progress</h3>
          <ul>
            {lab.map((w) => (
              <li>
                <a href={`/work/${w.id}`} class="lab-name">
                  {w.data.name}
                </a>
                <span class="lab-line">{w.data.line}</span>
                <span class="lab-status t-ui">{w.data.status}</span>
              </li>
            ))}
          </ul>
        </div>
      )
    }
  </section>

  <section class="band wrap" aria-labelledby="practice-title">
    <header class="band-head">
      <h2 id="practice-title" class="band-title">Disciplines</h2>
      <p class="band-note">Eight fields, each started on a known date and practised through real work.</p>
      <p class="band-more t-ui"><a href="/about#practice">How I work</a></p>
    </header>
    <Strata />
  </section>

  {
    essays.length > 0 && (
      <section class="band wrap" aria-labelledby="writing-title">
        <header class="band-head">
          <h2 id="writing-title" class="band-title">
            Writing
          </h2>
          <p class="band-note">Essays on capital, technology and objects.</p>
          <p class="band-more t-ui">
            <a href="/writing">All writing</a>
            <a href="/rss.xml">RSS</a>
          </p>
        </header>
        <EssayList essays={essays} />
      </section>
    )
  }

  <section class="band wrap" aria-labelledby="instruments-title">
    <header class="band-head">
      <h2 id="instruments-title" class="band-title">Instruments</h2>
      <p class="band-note">Small calculators for deals, products and pieces. They run in your browser.</p>
      <p class="band-more t-ui"><a href="/instruments">All instruments</a></p>
    </header>
    <InstrumentList />
  </section>
</Base>

<style>
  /* ---------- Hero ---------- */
  .hero {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    column-gap: clamp(12px, 2vw, 32px);
    align-items: center;
    padding-top: var(--s6);
    padding-bottom: var(--s5);
  }

  .head {
    grid-column: 1 / span 6;
  }

  .name {
    font-size: clamp(3rem, 1rem + 6vw, 5.5rem);
    line-height: 0.95;
    letter-spacing: 0.02em;
    white-space: nowrap;
  }

  .claim {
    font-family: var(--font-title);
    margin-top: var(--s4);
    font-size: var(--step-3);
    line-height: 1.15;
    letter-spacing: -0.01em;
    max-width: 18em;
  }

  .intro {
    margin-top: var(--s2);
    font-size: var(--step-1);
    line-height: 1.5;
    max-width: 30em;
    color: var(--line-2);
  }

  .roles {
    list-style: none;
    margin-top: var(--s5);
    border-top: 1px solid var(--line);
    max-width: 48rem;
  }

  .roles li {
    display: grid;
    grid-template-columns: minmax(0, 1.45fr) minmax(0, 0.9fr) minmax(0, 1.45fr);
    gap: var(--s3);
    align-items: baseline;
    padding-block: 0.7rem;
    border-bottom: 1px solid var(--rule);
  }

  .org {
    font-size: var(--step-0);
    font-weight: 500;
  }

  .role {
    font-size: var(--step--1);
    color: var(--line-2);
  }

  .what {
    color: var(--line-2);
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s1) var(--s4);
    margin-top: var(--s4);
    font-size: var(--step--1);
    font-weight: 500;
  }

  .actions a {
    text-decoration-color: var(--line);
    padding-block: 0.6rem;
  }

  .studies {
    display: contents;
  }

  .s {
    min-width: 0;
  }

  /* Desktop: the solid beside the introduction, smaller studies in its
     margin, the rest of the sheet below at varied sizes and heights. */
  .head {
    grid-row: 1 / span 2;
    align-self: start;
  }
  .s-poly {
    grid-column: 7 / span 3;
    grid-row: 1;
    align-self: start;
  }
  .s-letter {
    grid-column: 10 / span 3;
    grid-row: 1;
    align-self: start;
    margin-top: var(--s4);
  }
  .s-esc {
    grid-column: 7 / span 6;
    grid-row: 2;
    align-self: start;
    margin-top: var(--s4);
  }
  .s-env {
    grid-column: 1 / span 4;
    grid-row: 3;
    margin-top: var(--s7);
  }
  .s-amm {
    grid-column: 5 / span 3;
    grid-row: 3;
    margin-top: var(--s8);
  }
  .s-bridge {
    grid-column: 9 / span 3;
    grid-row: 3;
    margin-top: var(--s6);
  }
  .s-die {
    grid-column: 2 / span 3;
    grid-row: 4;
    margin-top: var(--s5);
  }
  .s-route {
    grid-column: 8 / span 3;
    grid-row: 4;
    margin-top: var(--s4);
  }

  .swipe {
    display: none;
    color: var(--line-2);
  }

  @media (max-width: 1100px) {
    .head {
      grid-column: 1 / -1;
      grid-row: 1;
    }
    .s-poly {
      grid-column: 1 / span 6;
      grid-row: 2;
      margin-top: var(--s6);
    }
    .s-letter {
      grid-column: 8 / span 5;
      grid-row: 2;
      margin-top: var(--s6);
    }
    .s-esc {
      grid-column: 1 / span 6;
      grid-row: 3;
    }
    .s-env {
      grid-column: 7 / span 6;
      grid-row: 3;
      margin-top: var(--s5);
    }
    .s-amm {
      grid-column: 1 / span 6;
      grid-row: 4;
    }
    .s-bridge {
      grid-column: 7 / span 6;
      grid-row: 4;
      margin-top: var(--s6);
    }
    .s-die {
      grid-column: 1 / span 6;
      grid-row: 5;
    }
    .s-route {
      grid-column: 7 / span 6;
      grid-row: 5;
      margin-top: var(--s5);
    }
  }

  /* Phones: words first, then the sheet as a strip, two drawings at a time. */
  @media (max-width: 700px) {
    .hero {
      display: block;
      padding-top: var(--s4);
    }
    .name {
      font-size: 16vw;
    }
    .roles li {
      grid-template-columns: 1fr auto;
      row-gap: 0.15rem;
    }
    .what {
      grid-column: 1 / -1;
      font-size: var(--step--1);
    }
    .studies {
      display: flex;
      gap: var(--s3);
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      margin: var(--s5) calc(-1 * var(--gutter)) 0;
      padding: 0 var(--gutter) var(--s2);
      scroll-padding-inline: var(--gutter);
      scrollbar-width: none;
      align-items: flex-end;
    }
    .studies::-webkit-scrollbar {
      display: none;
    }
    .s {
      flex: 0 0 calc((100vw - 2 * var(--gutter) - var(--s3)) / 2);
      scroll-snap-align: start;
      margin: 0 !important;
    }
    .s :global(figcaption .meta) {
      display: none;
    }
    .s :global(figcaption .t-note) {
      font-size: var(--step--1);
    }
    .swipe {
      display: block;
      font-size: var(--step--1);
      margin-top: var(--s1);
    }
  }

  /* ---------- Bands ---------- */
  .band {
    margin-top: var(--s8);
  }

  .band-head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--s1) var(--s4);
    padding-bottom: var(--s3);
  }

  .band-title {
    font-family: var(--font-text);
    font-size: var(--step-4);
    line-height: 1;
    letter-spacing: -0.015em;
  }

  .band-note {
    flex: 1 1 18rem;
    color: var(--line-2);
    max-width: 34em;
  }

  .band-more {
    margin-left: auto;
    display: flex;
    gap: var(--s3);
    font-size: var(--step--1);
  }

  @media (max-width: 900px) {
    .band {
      margin-top: var(--s7);
    }
    .band-more {
      margin-left: 0;
    }
  }

  .plates {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    column-gap: clamp(12px, 2vw, 32px);
    row-gap: var(--s5);
    align-items: start;
  }

  .plate-fig {
    display: grid;
    gap: var(--s3);
  }

  .plate-entity {
    grid-column: 1 / span 7;
  }

  .plate-orbes {
    grid-column: 8 / span 5;
  }

  .plate-cap h3 {
    font-family: var(--font-text);
    font-size: var(--step-2);
    line-height: 1.1;
  }

  .plate-cap h3 a {
    text-decoration-color: transparent;
  }

  .plate-cap h3 a:hover {
    text-decoration-color: var(--line);
  }

  .plate-cap p {
    margin-top: 0.3rem;
    color: var(--line-2);
    max-width: 34em;
  }

  @media (max-width: 900px) {
    .plate-entity,
    .plate-orbes {
      grid-column: 1 / -1;
    }
  }

  .lab {
    margin-top: var(--s6);
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 3fr);
    gap: var(--s4);
  }

  .lab-title {
    font-family: var(--font-text);
    font-size: var(--step-1);
    padding-top: 0.8rem;
  }

  .lab ul {
    list-style: none;
    border-top: 1px solid var(--line);
  }

  .lab li {
    display: grid;
    grid-template-columns: 9rem minmax(0, 1fr) auto;
    gap: var(--s3);
    align-items: baseline;
    padding-block: 0.9rem;
    border-bottom: 1px solid var(--rule);
  }

  .lab-name {
    font-size: var(--step-1);
  }

  .lab-line {
    color: var(--line-2);
  }

  .lab-status {
    font-size: var(--step--2);
    color: var(--line-2);
  }

  @media (max-width: 760px) {
    .lab {
      grid-template-columns: 1fr;
    }
    .lab li {
      grid-template-columns: 1fr auto;
      row-gap: 0.2rem;
    }
    .lab-line {
      grid-column: 1 / -1;
      grid-row: 2;
    }
  }
</style>

<script>
  // Hovering a discipline lights its drawing, and the other way round.
  const figs = new Map<string, HTMLElement>();
  document.querySelectorAll<HTMLElement>('figure.study[data-study]').forEach((f) => figs.set(f.dataset.study!, f));
  document.querySelectorAll<HTMLElement>('.strata .row[data-study]').forEach((row) => {
    const fig = figs.get(row.dataset.study!);
    if (!fig) return;
    const on = () => (row.classList.add('is-lit'), fig.classList.add('is-lit'));
    const off = () => (row.classList.remove('is-lit'), fig.classList.remove('is-lit'));
    for (const el of [row, fig]) {
      el.addEventListener('pointerenter', on);
      el.addEventListener('pointerleave', off);
      el.addEventListener('focusin', on);
      el.addEventListener('focusout', off);
    }
  });
</script>
