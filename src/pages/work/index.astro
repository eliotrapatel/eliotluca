---
import Base from '../../layouts/Base.astro';
import PageHead from '../../components/PageHead.astro';
import EntityShowcase from '../../components/ventures/EntityShowcase.astro';
import OrbesShowcase from '../../components/ventures/OrbesShowcase.astro';
import BrandMark from '../../components/brand/BrandMark.astro';
import { getCollection } from 'astro:content';

const ventures = (await getCollection('work', ({ data }) => data.visible && data.tier === 'venture')).sort(
  (a, b) => a.data.order - b.data.order,
);
const showcases: Record<string, any> = { 'the-entity': EntityShowcase, orbes: OrbesShowcase };
const marks: Record<string, 'entity' | 'orbes'> = { 'the-entity': 'entity', orbes: 'orbes' };
---

<Base title="Ventures" description="THE ENTITY and ORBES, the two companies Eliot Luca is building." image="/og/work.png">
  <PageHead title="Ventures" lede="Two companies, both anchored in the physical world." />

  <section class="wrap ventures" aria-label="Ventures">
    {
      ventures.map((w, i) => {
        const Showcase = showcases[w.id];
        return (
          <article class:list={['venture', { flip: i % 2 === 1 }]}>
            <div class="card">{Showcase && <Showcase headingLevel="h3" />}</div>
            <div class="text">
              <h2 class:list={['v-name', `v-name--${marks[w.id] ?? 'plain'}`]}>
                <a href={`/work/${w.id}`}>
                  {marks[w.id] && (
                    <span class:list={['v-mark', `v-mark--${marks[w.id]}`]} aria-hidden="true">
                      <BrandMark id={marks[w.id]} />
                    </span>
                  )}
                  {w.data.name}
                </a>
              </h2>
              <p class="v-line">{w.data.summary ?? w.data.line}</p>
              {(w.data.points ?? []).length > 0 && (
                <ul class="v-points">
                  {(w.data.points ?? []).map((pt: string) => (
                    <li>{pt}</li>
                  ))}
                </ul>
              )}
              <dl class="v-meta">
                <div>
                  <dt>Role</dt>
                  <dd>{w.data.role}</dd>
                </div>
                <div>
                  <dt>Status</dt>
                  <dd>{w.data.status}</dd>
                </div>
                <div>
                  <dt>Since</dt>
                  <dd>{w.data.since}</dd>
                </div>
              </dl>
              <p class="v-links">
                <a class="btn" href={`/work/${w.id}`}>
                  More on {w.data.name}
                </a>
                {w.data.url && (
                  <a class="ext" href={w.data.url} rel="noopener">
                    {w.data.urlLabel ?? w.data.url}
                  </a>
                )}
              </p>
            </div>
          </article>
        );
      })
    }
  </section>
</Base>

<style>
  .ventures {
    display: grid;
    gap: var(--s8);
  }

  .venture {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    column-gap: clamp(12px, 2vw, 32px);
    row-gap: var(--s4);
    align-items: center;
  }

  .card {
    grid-column: 1 / span 7;
  }

  .text {
    grid-column: 9 / span 4;
  }

  .flip .card {
    grid-column: 6 / span 7;
    grid-row: 1;
  }

  .flip .text {
    grid-column: 1 / span 4;
    grid-row: 1;
  }

  /* The names are logotypes: Gravesend capitals, as on each house's own site. */
  .v-name {
    font-family: var(--font-brand);
    font-weight: 500;
    font-size: var(--step-3);
    line-height: 1.05;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .v-name--orbes {
    letter-spacing: 0.4em;
  }

  .v-name a {
    display: inline-flex;
    align-items: center;
    gap: 0.5em;
    text-decoration: none;
  }

  .v-mark {
    flex: none;
    display: block;
    width: 1.05em;
    /* Capitals sit low in their line box; bring the mark down to their centre. */
    transform: translateY(0.07em);
  }

  .v-mark--orbes {
    width: 1.4em;
  }

  .v-mark--entity {
    color: #7abdb4;
  }

  .v-mark--orbes {
    color: #f6f2ea;
  }

  .v-mark :global(svg) {
    display: block;
    width: 100%;
    height: auto;
  }

  .v-points {
    list-style: none;
    margin-top: var(--s3);
    display: grid;
    gap: 0.6rem;
    font-size: var(--step--1);
    line-height: 1.5;
    color: var(--line-2);
  }

  .v-points li {
    position: relative;
    padding-left: 1.1rem;
  }

  .v-points li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.62em;
    width: 0.5rem;
    border-top: 1px solid var(--gold);
  }

  .v-name a:hover {
    color: var(--gold);
  }

  .v-line {
    margin-top: var(--s2);
    color: var(--line-2);
  }

  .v-meta {
    margin: var(--s4) 0 0;
    border-top: 1px solid var(--border-2);
    font-size: var(--step--1);
  }

  .v-meta div {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    padding-block: 0.6rem;
    border-bottom: 1px solid var(--rule);
  }

  .v-meta dt {
    color: var(--line-2);
  }

  .v-meta dd {
    margin: 0;
    text-align: right;
  }

  .v-links {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--s2) var(--s3);
    margin-top: var(--s4);
  }

  .ext {
    font-size: var(--step--1);
    color: var(--line-2);
  }

  @media (max-width: 960px) {
    .card,
    .text,
    .flip .card,
    .flip .text {
      grid-column: 1 / -1;
      grid-row: auto;
    }
  }
</style>
