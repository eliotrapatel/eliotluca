---
// The link-in-bio page: one column, large targets, nothing else.
import Base from '../layouts/Base.astro';
import Polyhedron from '../components/studies/Polyhedron.astro';
import { site } from '../data/site';
import { getEssays } from '../lib/writing';

const latest = (await getEssays())[0];

const links = [
  { label: 'THE ENTITY', note: 'The map of the AI supply chain', href: 'https://joinentity.com' },
  { label: 'ORBES', note: 'Jewellery house, Paris', href: 'https://theorbes.com' },
  { label: 'The Orchid ring', note: 'Current ORBES release, by draw', href: 'https://verify.theorbes.com' },
  latest && { label: latest.data.title, note: `Latest writing, No. ${latest.number}`, href: `/writing/${latest.id}` },
  { label: 'Instruments', note: 'Returns, dilution, copilot costs, ring sizes', href: '/instruments' },
  site.social.linkedin && { label: 'LinkedIn', note: 'Career and contact', href: site.social.linkedin },
  site.social.x && { label: 'X', note: 'Notes in public', href: site.social.x },
  site.social.instagram && { label: 'Instagram', note: 'Pictures', href: site.social.instagram },
  site.social.github && { label: 'GitHub', note: 'Code', href: site.social.github },
  { label: 'Write to me', note: site.email, href: `mailto:${site.email}` },
].filter(Boolean) as { label: string; note: string; href: string }[];
---

<Base title="Links" description="Every link to Eliot Luca's work in one place." image="/og/links.png" bare>
  <div class="links-page">
    <header class="top">
      <div class="emblem"><Polyhedron href="/" /></div>
      <h1 class="t-title name"><a href="/">Eliot Luca</a></h1>
      <p class="line">Capital, code and craft. Founder of THE ENTITY and ORBES.</p>
    </header>

    <ul class="list">
      {
        links.map((l) => (
          <li>
            <a href={l.href} rel={l.href.startsWith('http') ? 'noopener me' : undefined}>
              <span class="txt">
                <span class="label">{l.label}</span>
                <span class="note">{l.note}</span>
              </span>
              <svg class="arrow" viewBox="0 0 14 14" aria-hidden="true"><path d="M3 11 11 3M5 3h6v6" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"></path></svg>
            </a>
          </li>
        ))
      }
    </ul>

    <p class="home t-label"><a href="/">eliotluca.com</a></p>
  </div>
</Base>

<style>
  .links-page {
    max-width: 30rem;
    margin: 0 auto;
    padding: var(--s5) var(--gutter) var(--s5);
  }

  .top {
    text-align: center;
    display: grid;
    justify-items: center;
  }

  .emblem {
    width: 120px;
  }

  .emblem :global(figcaption),
  .emblem :global(.hint) {
    display: none;
  }

  .name {
    margin-top: var(--s2);
    font-size: var(--step-4);
  }

  .name a {
    text-decoration: none;
  }

  .line {
    margin-top: var(--s1);
    color: var(--line-2);
    max-width: 22em;
  }

  .list {
    list-style: none;
    margin-top: var(--s5);
    display: grid;
    gap: 10px;
  }

  .list a {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    min-height: 4.25rem;
    padding: 0.9rem 1.1rem;
    border-radius: var(--radius-sm);
    border: 1px solid var(--border);
    background: linear-gradient(180deg, rgb(255 255 255 / 0.035), rgb(255 255 255 / 0.01)), var(--panel);
    text-decoration: none;
    transition:
      border-color 200ms var(--ease-out),
      transform 200ms var(--ease-out);
  }

  .list a:hover,
  .list a:focus-visible {
    border-color: rgb(205 182 138 / 0.4);
    transform: translateY(-2px);
  }

  .txt {
    display: grid;
    gap: 2px;
    min-width: 0;
  }

  .label {
    font-weight: 500;
    font-size: var(--step-1);
    letter-spacing: -0.01em;
  }

  .note {
    font-size: var(--step--1);
    color: var(--line-2);
  }

  .arrow {
    flex: none;
    width: 14px;
    height: 14px;
    color: var(--line-2);
  }

  .list a:hover .arrow {
    color: var(--gold);
  }

  .home {
    margin-top: var(--s5);
    text-align: center;
  }

  .home a {
    text-decoration: none;
  }
</style>
